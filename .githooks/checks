#!/bin/sh
# labkit's checks, one home for both hooks: ruff, ruff format, pyright and
# pytest, each judged by its own exit code — no pipe in front of a verdict (a
# commit went in with pyright red because `pyright | tail` exited 0,
# 2026-10-07).
#
#   .githooks/checks fast   before each commit: pytest without the end-to-end
#                           scenario files (`pytestmark = pytest.mark.slow`)
#   .githooks/checks full   before a push and a release: the whole suite
#
# Why two tiers: the scenario files hold most of the suite's time — measured
# on 2026-11-10, when 13 files carried the mark: ~80 %, 383 s whole, 81 s
# without them, on 11 cores; more files carry it since, not timed again.
# A commit that breaks a scenario is caught at the push, never on GitHub.
set -u
tier=${1:-}
case "$tier" in
    fast | full) ;;
    *) echo "checks: say fast or full" >&2; exit 2 ;;
esac
cd "$(git rev-parse --show-toplevel)" || exit 1
venv=.venv/bin
if [ ! -x "$venv/python" ]; then
    echo "checks: no $venv/python — create it: python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'" >&2
    exit 1
fi
gitdir=$(git rev-parse --absolute-git-dir)
# The state the checks read: the tree of every file not ignored, as the
# working tree holds it (tracked and untracked, through an index of its own,
# since the checks read the tree and not the commit), the interpreter and the
# installed packages. Editable installs are left out (labkit is the only
# one): its line names HEAD, which the release commit moves, and its code is
# in the tree. Not in the key, so a change there is not seen: ignored files
# (`.gitignore`, `.git/info/exclude`, the global ignore), the content of a
# nested repository (only its commit), tags and environment variables.
# Empty when git cannot build the tree; then nothing is reused or recorded.
state_key() {
    tmp=$(mktemp -d) || return 1
    tree=$(GIT_INDEX_FILE="$tmp/index" git read-tree HEAD 2>/dev/null &&
        GIT_INDEX_FILE="$tmp/index" git add -A . 2>/dev/null &&
        GIT_INDEX_FILE="$tmp/index" git write-tree 2>/dev/null)
    code=$?
    rm -rf "$tmp"
    [ "$code" -eq 0 ] || return 1
    python=$("$venv/python" -V 2>&1) || return 1
    packages=$("$venv/python" -m pip freeze --exclude-editable 2>/dev/null | git hash-object --stdin) || return 1
    printf 'tree %s\n%s\npackages %s\n' "$tree" "$python" "$packages"
}
# A whole run that passed on this state stands for both tiers (the fast tier
# is part of it): the release's run before its commit is reused by the
# commit hook and the push hook, where the same content ran again for about
# twelve minutes (2026-11-20). Written only by a green full run whose state
# did not change while it ran — a green fast run records nothing. Kept in
# this worktree's git dir, so another worktree runs its own. Delete the file
# to run anyway.
record="$gitdir/labkit-checks-passed"
key=$(state_key) || key=""
if [ -n "$key" ] && [ -f "$record" ] && [ "$(cat "$record")" = "$key" ]; then
    said="checks ($tier): the whole checks passed on this state already, not run again (record: $record)"
    # the tier's log says so too, never an earlier run's output under this one
    printf '%s\n' "$said" > "$gitdir/labkit-checks-$tier.log"
    echo "$said"
    exit 0
fi
fail=0
# Every check's whole output and exit code, kept until the next run of this
# tier: a failure shown as its last 25 lines could not be told apart from a
# known flaky test afterwards (2026-11-03). In this worktree's own git dir.
log="$gitdir/labkit-checks-$tier.log"
: > "$log"
run() {
    name=$1
    shift
    out=$("$@" 2>&1)
    code=$?
    { printf '== %s\n' "$name"; printf '%s\n' "$out"; printf 'exit %s\n\n' "$code"; } >> "$log"
    if [ "$code" -ne 0 ]; then
        echo "checks ($tier): $name failed (exit $code; the whole output: $log):" >&2
        printf '%s\n' "$out" | tail -25 >&2
        fail=1
    fi
}
run "ruff check" "$venv/ruff" check .
run "ruff format --check" "$venv/ruff" format --check .
run "pyright" "$venv/pyright"
# On every core. Until 2026-10-23 `--dist loadscope` kept each class on one
# worker because the end-to-end classes built test_04 on what test_02 left
# behind; every test builds its own state now (`_adopted`, `_committed`).
if [ "$tier" = fast ]; then
    run "pytest ($tier)" "$venv/python" -m pytest -q -p no:warnings -n auto -m "not slow"
else
    run "pytest ($tier)" "$venv/python" -m pytest -q -p no:warnings -n auto
fi
[ "$fail" -eq 0 ] || exit 1
echo "checks ($tier): ruff, format, pyright, pytest green"
if [ "$tier" = full ] && [ -n "$key" ]; then
    if [ "$(state_key)" = "$key" ]; then
        printf '%s\n' "$key" > "$record"
    else
        echo "checks ($tier): the state changed while the checks ran — green, but no record for a later hook" >&2
    fi
fi
