#!/bin/sh
# labkit's gate before a commit: the fast tier of the checks — ruff, ruff
# format, pyright and the suite without its end-to-end scenario files
# (`.githooks/checks fast`); the whole suite runs before a push
# (`.githooks/pre-push`). Turn on once per clone, for both hooks:
#   git config core.hooksPath .githooks
# Escape hatch for a deliberate exception: git commit --no-verify
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
# Notes and the TODO hold no code and no test reads them: a commit that
# stages nothing else skips the checks. Any other path, one .py among
# them, runs them. --no-renames: a file moved into docs/notes/ counts
# by its old path too. The index is the commit's (`git commit -- PATH`
# hands the hook its own).
staged=$(git diff --cached --name-only --no-renames)
if [ -n "$staged" ] && ! printf '%s\n' "$staged" | grep -qv -e '^docs/notes/' -e '^TODO\.md$'; then
    echo "pre-commit: only docs/notes/ and TODO.md staged — checks skipped"
    exit 0
fi
if ! .githooks/checks fast; then
    echo "pre-commit: commit refused — fix the above (or --no-verify for a deliberate exception)" >&2
    exit 1
fi
