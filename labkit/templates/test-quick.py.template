"""`<area>`: the number's function on a hand-checked case, before any run.

    .venv/bin/python -m pytest tests/test_<NN>_<name>.py

Imports the area's script by path under a unique name (two areas in one
pytest run must not share `01_measure`), never copies its formula. Until
KNOWN_IDS, KNOWN_ROWS and KNOWN_METRICS hold a case checked by hand, the
first two tests FAIL on purpose.
"""
from __future__ import annotations

import importlib.util
import sys
from pathlib import Path

import pytest

AREA = Path(__file__).resolve().parent.parent / "<area>"
_spec = importlib.util.spec_from_file_location("measure_<NN>_<name>", AREA / "scripts" / "01_measure.py")
assert _spec is not None and _spec.loader is not None
measure = importlib.util.module_from_spec(_spec)
sys.modules[_spec.name] = measure
_spec.loader.exec_module(measure)


#: TODO: a case you checked by hand — two or more rows in the shape rows()
#: returns, the ids they answer, and the number(s) evaluate_rows() must give
#: for them under their metrics keys, METRIC_KEY among them — worked out by
#: hand, never by calling the code
KNOWN_IDS: list[str] = []
KNOWN_ROWS: list[dict] = []
KNOWN_METRICS: dict = {}


def test_known_rows_give_the_known_number():
    assert len(KNOWN_ROWS) >= 2 and measure.METRIC_KEY in KNOWN_METRICS, (
        "fill KNOWN_IDS, KNOWN_ROWS and KNOWN_METRICS with a case checked by hand"
    )
    metrics = measure.evaluate_rows(KNOWN_ROWS, KNOWN_IDS)
    for key, value in KNOWN_METRICS.items():
        assert metrics[key] == pytest.approx(value), key


def test_a_lost_row_is_a_refusal_not_a_smaller_denominator():
    assert len(KNOWN_ROWS) >= 2, "the hand-checked case owes two rows at least"
    with pytest.raises(ValueError):
        measure.evaluate_rows(KNOWN_ROWS[:-1], KNOWN_IDS)


def test_hidden_entries_do_not_count(tmp_path):
    (tmp_path / "doc-1.txt").write_text("x")
    (tmp_path / ".DS_Store").write_text("x")
    (tmp_path / "nested").mkdir()
    assert [p.name for p in measure.visible(tmp_path)] == ["doc-1.txt"]
