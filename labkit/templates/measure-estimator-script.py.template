FIT_PLAN = {"low": (3, 2), "high": (5, 5)}
N_FOLDS, NULL_REFITS = FIT_PLAN[HEAD.repeat_cost]
MIN_NULL_REFITS = 2
SEED = 0
# TODO: the estimator and its FIXED parameters, as text — it is the
# instrument's version (estimator_sha): a changed line is a changed config.
ESTIMATOR = "TODO: e.g. RandomForestClassifier(n_estimators=500, random_state=seed)"
#: the two lanes every labelled item is scored in, in the same run — the
#: names finalize reads the kept rows by (`run_record_check.NULL_LANES`)
SCORED_LANES = ("registered", "null")
LANES = (*SCORED_LANES, "test")


def predictor_digests() -> dict[str, str]:
    """Read every declared predictor dependency and return its source digest.
    Empty for self-contained predictors. Missing or unreadable paths raise
    their filesystem error; directories use provenance's source-tree digest.
    """
    return {name: provenance.source_digest(path) for name, path in PREDICTOR_FILES.items()}


def data_files() -> dict[str, Path | provenance.BinaryInput]:
    """Inputs runlog records: prepared rows and every declared predictor
    dependency (the primary's, and a registered fixed null's). Predictor names are prefixed to keep the prepared input.
    Returns paths without reading or changing any file.
    """
    order = {"null_order": NULL_ORDER} if NULL_ORDER is not None else {}
    return {"prepared": ITEMS, **order,
            **{f"predictor_{name}": provenance.BinaryInput(path) for name, path in PREDICTOR_FILES.items()}}


def make_estimator(seed: int, probe: bool = False):
    """TODO: return the instrument: at fit, fit(X, y) and predict(X); at
    apply, load the already fixed predictor with predict(X), never train it.
    (for `auc`, predict must return a score per item; use predict_proba's
    positive column). At fit, PROBE asks for a reduced one (fewer trees,
    fewer iterations); at apply the instrument stays unchanged. Keep the library import HERE, so
    the area's test — which needs only `evaluate_rows` — imports this file
    without it. Fit-only example:

        from sklearn.ensemble import RandomForestClassifier
        return RandomForestClassifier(n_estimators=50 if probe else 500, random_state=seed)

    Apply-only example (declare the loaded path in PREDICTOR_FILES):

        from joblib import load
        return load(PREDICTOR_FILES["primary"])
    """
    raise NotImplementedError(f"make_estimator(): {ESTIMATOR}")


def make_null_predictor(seed: int, probe: bool = False):
    """At apply: None, the default — the null lane scores the primary's
    predictions against the gold labels permuted with SEED. Return a fixed
    null predictor with predict(X) only when the protocol registers one
    instead: it receives features only, never gold, and is never trained;
    declare its files in PREDICTOR_FILES, e.g. load(PREDICTOR_FILES["null"]).
    PROBE changes only the items. Fit never calls this: its null lane
    fits permuted labels.
    """
    return None


@dataclass(frozen=True)
class MeasureConfig:
    """Every value that shapes the number — one execution of this protocol.

    The PROTOCOL owns validity and meaning (criterion, registered constants,
    which run reports); this object materialises one execution; the run's
    config.json records it whole (`asdict(cfg)`); `evaluate_rows()` reads
    its thresholds from here and nowhere else. The thresholds have NO
    default: they come from the protocol's [[promise]] tables under the SAME
    name (`constants = { margin = 0.25 }` ↔ `margin`) through
    `promises.constants_into()`; runlog refuses a run whose config lacks a
    registered constant or carries another value, and at import a constant
    this class does not know fails (TypeError: unexpected keyword), as does
    one of another type than its field (PromiseError). A registered
    [criterion-1] (`bar_criterion`) registers exactly one of `at_least` and
    `margin`; both or neither raise ValueError here, before any row is
    read — and either without [criterion-1] too: a bar nothing judges.
    """

    max_empty: int              # [quality-check-1]: at most this many labelled items without a prediction
    # [criterion-1], one of the two (LAB-035 Thresholds belong to the run, not to the measure):
    at_least: float | None = None  # a bar the task states: registered score ≥ at_least, in score units;
                                # its source named in the criterion's sentence
    margin: float | None = None    # a bar of your own: registered score ≥ null value + margin, in score units
                                # (apply: the permutation expectation; fit: the refits' mean)
    null_band: float | None = None  # [quality-check-2]'s permitted deviation of the null from its target, in score units,
                                # where it is a reasoned value: fit, a fixed null predictor, optionally a NULL_ORDER;
                                # at apply with the seeded permuted null it is computed per run, and registering it is refused
    # [quality-check-2]'s calibration rule at apply with the seeded permuted
    # null, registered together: the permitted deviation is the
    # null_band_quantile quantile of |score against permuted gold −
    # permutation expectation| over null_permutations permutations seeded
    # by null_band_seed, rounded up to two places — computed in each run
    null_band_quantile: float | None = None
    null_permutations: int | None = None
    null_band_seed: int | None = None  # the calibration's seed, apart from the run's `seed`
    # [criterion-1] registered: the kept score judged against at_least, or the null value + margin
    bar_criterion: bool = False
    # [criterion-2] registered: score > permutation expectation + null_band (apply, calibration rule owed)
    chance_criterion: bool = False
    seed: int = SEED            # folds, permutation, estimator
    n_folds: int = N_FOLDS      # fit: the plan by repeat cost (FIT_PLAN), recorded with the run
    null_refits: int = NULL_REFITS  # fit: permuted-label refits per fold; [criterion-1]'s bar and
                                # [quality-check-2] read their mean, each draw is kept
    score: str = SCORE
    # the instrument's version: the estimator line, so a changed parameter is
    # a different config even when every threshold stays
    estimator_sha: str = digests.digest(ESTIMATOR.encode())
    # the declared predictor files' digests, set by main() from the files as
    # they are then — never at import: the area's test imports this file
    predictor_sha: dict[str, str] = field(default_factory=dict)

    def __post_init__(self) -> None:
        criterion_bar.require_form_if_registered(self.bar_criterion, self.at_least, self.margin)
        rule = (self.null_band_quantile, self.null_permutations, self.null_band_seed)
        if any(v is None for v in rule) and any(v is not None for v in rule):
            raise ValueError("null_band_quantile, null_permutations and null_band_seed are "
                             "registered together, or none of them")


# The registered execution: thresholds from the protocol, nothing copied;
# `--seed` replaces one field.
_BLOCK = promises.load(PROTOCOL)
CONFIG = promises.constants_into(MeasureConfig, _BLOCK,
                                 bar_criterion="criterion-1" in _BLOCK.by_id(),
                                 chance_criterion="criterion-2" in _BLOCK.by_id())
#: the kept number's key in metrics.json, as the protocol head's `[kept]`
#: names it — set there, never here; 02_analyze.py and the test read this
#: name. Read at import: a head without the table, or with its key still
#: the placeholder, stops the script and the area's test here with the
#: head's own sentence, before any gate runs; no key is chosen in its place
KEPT_KEY = protocol_block.kept_key(PROTOCOL.read_text(encoding="utf-8"))


def read_jsonl(path: Path) -> list[dict]:
    """Input records; the `_meta` header line is documentation, not data."""
    return batch.Store(path).records()


def labelled(items: list[dict]) -> list[dict]:
    """The items with a gold value — the scored lanes are over exactly these."""
    return [it for it in items if it.get(GOLD_FIELD) is not None]


def unlabelled(items: list[dict]) -> list[dict]:
    """The items without gold — predicted by the test lane, never scored."""
    return [it for it in items if it.get(GOLD_FIELD) is None]


def folds(n: int, k: int, seed: int) -> list[list[int]]:
    """K folds of the indices 0..n-1, shuffled by SEED; sizes differ by at most one."""
    if n < k:
        raise ValueError(f"folds(): {n} labelled items for {k} folds — fewer folds, or more items")
    order = list(range(n))
    random.Random(seed).shuffle(order)
    return [order[i::k] for i in range(k)]


def _plain(value):
    """A JSON-safe scalar: numpy scalars carry their value in .item()."""
    return value.item() if hasattr(value, "item") else value


def fit_predict(cfg: MeasureConfig, fit: list[dict], predict: list[dict],
                permute: random.Random | None, probe: bool) -> list:
    """Fit a fresh estimator on FIT (labels permuted by PERMUTE for the null
    lane) and predict PREDICT; never the same items on both sides."""
    est = make_estimator(cfg.seed, probe)
    y = [it[GOLD_FIELD] for it in fit]
    if permute is not None:
        permute.shuffle(y)
    est.fit([it[FEATURES_FIELD] for it in fit], y)
    return [_plain(p) for p in est.predict([it[FEATURES_FIELD] for it in predict])]


def instrument(cfg: MeasureConfig, items: list[dict]) -> dict:
    """What makes two predictions comparable: the measuring code (this
    script and the local modules it imports), the estimator line, the
    score, declared predictor dependencies as they read now, the seed,
    folds and items. Filesystem errors from reading dependencies propagate.
    Every row carries it; a resume refuses rows of another (batch.Store
    `instrument`) — without the code, a fix measured again kept the faulty
    rows. The items as one fingerprint, not one per item: an edited item
    changes the fit, so every prediction."""
    return {"code_sha": scope_sha.measured_code_sha(Path(__file__).resolve(), REPO),
            "estimator_sha": cfg.estimator_sha, "predictor_sha": predictor_digests(), "score": cfg.score,
            "seed": cfg.seed, "n_folds": cfg.n_folds, "items_sha": batch.content_sha(items)}


def null_draws(cfg: MeasureConfig) -> list[int | None]:
    """The draws of the null lane, as its rows number them: at fit the
    `cfg.null_refits` refits (0, 1, …), at apply one unnumbered draw."""
    return list(range(cfg.null_refits)) if KIND == "fit" else [None]


def expected(items: list[dict], cfg: MeasureConfig) -> list[dict]:
    """The rows a complete run holds under CFG's plan, by id: the registered
    lane and each null draw over the labelled items, the test lane over the
    unlabelled ones."""
    return ([{"id": f"registered:{it['id']}"} for it in labelled(items)]
            + [{"id": row_id("null", it, d)} for d in null_draws(cfg) for it in labelled(items)]
            + [{"id": f"test:{it['id']}"} for it in unlabelled(items)])


def measure(cfg: MeasureConfig, items: list[dict], out: Path,
            prov: dict | None = None, probe: bool = False,
            budget_s: int | None = None) -> list[dict]:
    """Predict every item in its lanes and write OUT, with PROV on every row.
    BUDGET_S, the protocol's Timebox in seconds, lets a fit project itself
    after its first fold and stop before the budget (`fit_rows`).

    Apply predicts with the unchanged primary (its null lane on permuted
    gold, or a registered fixed null) without training; fit uses
    out-of-fold registered/permuted-label training and fits all labelled
    items for the unlabelled test lane. A short prediction list raises
    ValueError rather than dropping items. No other kind is accepted.
    """
    if KIND not in ("fit", "apply"):
        raise ValueError(f"measure(): kind must be fit or apply, got {KIND!r} — set [protocol] kind in the head")
    identity = instrument(cfg, items)
    if identity["predictor_sha"] != cfg.predictor_sha:
        if not cfg.predictor_sha:   # CONFIG as imported: no snapshot was taken
            raise ValueError("measure(): cfg carries no predictor snapshot — main() takes it; "
                             "a caller passes replace(CONFIG, predictor_sha=predictor_digests())")
        raise ValueError("measure(): predictor dependencies changed since the config snapshot")
    rows = (apply_rows(cfg, items, probe) if KIND == "apply"
            else fit_rows(cfg, items, probe, budget_s=budget_s))
    if predictor_digests() != cfg.predictor_sha:
        raise ValueError("measure(): predictor dependencies changed during prediction")
    with batch.Store(out, prov=prov, instrument=identity) as store:
        for r in store.pending(rows):
            store.append(r)
    print(f"rows: {len(rows)} — {len(labelled(items))} labelled items in two lanes, {len(unlabelled(items))} test items")
    return rows


def predict_all(predictor, part: list[dict], who: str) -> list:
    """PREDICTOR's answers for every item of PART, as plain values — strict:
    fewer or more answers than items is refused, never cut short. WHO names
    the caller in the ValueError."""
    answers = list(predictor.predict([it[FEATURES_FIELD] for it in part]))
    if len(answers) != len(part):
        raise ValueError(f"{who}: {len(answers)} predictions for {len(part)} items")
    return [_plain(a) for a in answers]


def row_id(lane: str, it: dict, draw: int | None = None) -> str:
    """A kept row's id: `<lane>:<item>`, `<lane>:<draw>:<item>` for a
    numbered null draw."""
    return f"{lane}:{it['id']}" if draw is None else f"{lane}:{draw}:{it['id']}"


def lane_row(lane: str, it: dict, pred, gold, fold: int | None = None,
             draw: int | None = None, **more) -> dict:
    """One kept row: item IT predicted PRED in LANE, scored against GOLD
    (None for the test lane), with its FOLD, its null DRAW (fit) and MORE
    (`gold_of`)."""
    row = {"id": row_id(lane, it, draw), "lane": lane, "item": it["id"],
           "fold": fold, "pred": pred, "gold": gold, **more}
    if draw is not None:
        row["draw"] = draw
    return row


def apply_rows(cfg: MeasureConfig, items: list[dict], probe: bool) -> list[dict]:
    """Rows of the unchanged primary predictor, never fitted nor given gold:
    the registered lane over the labelled items, the test lane over the
    unlabelled ones. The null lane scores the registered predictions
    against the labelled items' gold permuted with the seed, each row
    naming whose label it carries (`gold_of`); a fixed null predictor
    from `make_null_predictor()` predicts it instead. Raises ValueError
    for a predictor returning the wrong number of answers.
    """
    primary = make_estimator(cfg.seed, probe)
    null = make_null_predictor(cfg.seed, probe)
    train, test = labelled(items), unlabelled(items)

    def predict(predictor, part: list[dict]) -> list:
        return predict_all(predictor, part, "apply_rows()")

    registered = predict(primary, train) if train else []
    rows = [lane_row("registered", it, p, it[GOLD_FIELD]) for it, p in zip(train, registered)]
    if null is None:
        donors = registered_donors(train) if NULL_ORDER is not None else list(train)
        if NULL_ORDER is None:
            random.Random(f"apply-null:{cfg.seed}").shuffle(donors)
        rows += [lane_row("null", it, p, d[GOLD_FIELD], gold_of=d["id"])
                 for it, p, d in zip(train, registered, donors)]
    elif train:
        rows += [lane_row("null", it, p, it[GOLD_FIELD]) for it, p in zip(train, predict(null, train))]
    if test:
        rows += [lane_row("test", it, p, None) for it, p in zip(test, predict(primary, test))]
    return rows


def registered_donors(train: list[dict]) -> list[dict]:
    """The labelled items in NULL_ORDER's order: row i's label comes from
    TRAIN[order[i]]. Raises ValueError when the file is not a JSON list of
    the positions 0 … len(TRAIN) − 1, each once — a registered order that
    does not fit the items is no control; the staged file is read, never
    regenerated (docs/notes/2026-11-01-registered-null-order.md)."""
    order = json.loads(Path(NULL_ORDER).read_text(encoding="utf-8"))
    if not isinstance(order, list) or sorted(order) != list(range(len(train))):
        raise ValueError(
            f"{NULL_ORDER}: not a permutation of the {len(train)} labelled items' "
            f"positions (0 … {len(train) - 1}, each once)")
    return [train[j] for j in order]


def fit_rows(cfg: MeasureConfig, items: list[dict], probe: bool,
             budget_s: int | None = None, clock=time.monotonic) -> list[dict]:
    """Out-of-fold registered rows, `cfg.null_refits` draws of out-of-fold
    permuted-label rows, and unlabelled test rows; every lane and draw fits
    a fresh estimator. Returns rows without writing them. With BUDGET_S
    (the protocol's Timebox in seconds) the first fold is timed by CLOCK and
    the whole run projected (`timebox.projected_seconds`); a projection
    over the budget raises SystemExit with the numbers and the way out
    before the second fold starts. Fewer than MIN_NULL_REFITS refits are
    refused: one draw's score would set the bar.
    """
    if cfg.null_refits < MIN_NULL_REFITS:
        raise ValueError(f"fit_rows(): null_refits = {cfg.null_refits} — at least {MIN_NULL_REFITS}, "
                         "so that no single draw sets the bar (FIT_PLAN)")
    train, test = labelled(items), unlabelled(items)
    rows: list[dict] = []
    started = clock()
    for k, held in enumerate(folds(len(train), cfg.n_folds, cfg.seed)):
        held_set = set(held)
        fit = [train[i] for i in range(len(train)) if i not in held_set]
        out_items = [train[i] for i in held]
        draws = [("registered", None, None)] + [
            ("null", d, random.Random(f"fit-null:{cfg.seed}:{k}:{d}")) for d in range(cfg.null_refits)
        ]
        for lane, d, permute in draws:
            preds = fit_predict(cfg, fit, out_items, permute, probe)
            # strict: a fit_predict that returns fewer predictions is refused,
            # never cut to the shorter list (the missing items would vanish)
            rows += [lane_row(lane, it, p, it[GOLD_FIELD], fold=k, draw=d)
                     for it, p in zip(out_items, preds, strict=True)]
        if k == 0 and budget_s is not None and not probe:
            first_fold_s = clock() - started
            projected = timebox.projected_seconds(first_fold_s, cfg.n_folds, len(draws), bool(test))
            refusal = timebox.over_budget(projected, budget_s, first_fold_s, cfg.n_folds, len(draws))
            if refusal:
                raise SystemExit(f"measurement stopped: {refusal}")
    if test:
        preds = fit_predict(cfg, train, test, None, probe)
        rows += [lane_row("test", it, p, None) for it, p in zip(test, preds, strict=True)]
    return rows


def answer_of(r: dict):
    """The prediction a row carries — what `02_analyze.py --draws` compares across draws."""
    return r["pred"]


# --- the scores: exact where the data is exact (Fraction), so a lane sitting
# exactly at null + margin passes (floats put the bar one ulp high, 2026-10-14)

def _accuracy(pairs: list[tuple]) -> Fraction:
    """Correct over every item; a missing prediction is not correct."""
    return Fraction(sum(1 for p, g in pairs if p is not None and p == g), len(pairs))


def _r2(pairs: list[tuple]) -> Fraction:
    """1 - SSE/SST over every item, exact over the float values; a missing
    prediction counts as the gold mean."""
    # exact: in floats constant predictions scored apart by rounding under a
    # permutation, a spread of 1e-16 the rounded-up deviation made 0.01
    golds = [Fraction(float(g)) for _, g in pairs]
    mean = sum(golds, Fraction(0)) / len(golds)
    sst = sum(((g - mean) ** 2 for g in golds), Fraction(0))
    if sst == 0:
        raise ValueError("r2: the gold values have no variance — nothing to explain")
    sse = sum((((mean if p is None else Fraction(float(p))) - g) ** 2
               for (p, _), g in zip(pairs, golds)), Fraction(0))
    return 1 - sse / sst


def _auc(pairs: list[tuple]) -> Fraction:
    """ROC-AUC as the Mann–Whitney statistic with ties counted half, over every
    item: gold truthy = positive; a missing score ranks below every real one."""
    scored = [(float("-inf") if p is None else float(p), bool(g)) for p, g in pairs]
    pos = [s for s, g in scored if g]
    neg = [s for s, g in scored if not g]
    if not pos or not neg:
        raise ValueError("auc: both classes must be present in the gold")
    wins = sum(2 if sp > sn else 1 if sp == sn else 0 for sp in pos for sn in neg)
    return Fraction(wins, 2 * len(pos) * len(neg))


def _mean_ranks(values: list[float]) -> list[Fraction]:
    """The rank of each value, 1 for the smallest; tied values share the mean
    of the ranks they span."""
    order = sorted(range(len(values)), key=lambda i: values[i])
    ranks: list[Fraction] = [Fraction(0)] * len(values)
    start = 0
    while start < len(order):
        end = start
        while end + 1 < len(order) and values[order[end + 1]] == values[order[start]]:
            end += 1
        for i in order[start:end + 1]:
            ranks[i] = Fraction(start + end + 2, 2)
        start = end + 1
    return ranks


def _spearman(pairs: list[tuple]) -> Fraction | float:
    """Spearman's rho over every item: the Pearson correlation of the mean
    ranks (ties share their mean rank); a missing prediction ranks below every
    real one. Exact (Fraction) when the denominator's square root is
    rational — always without ties —, else a float. Raises ValueError when
    the predictions or the gold are constant: rho is undefined there, not 0."""
    x = _mean_ranks([float("-inf") if p is None else float(p) for p, _ in pairs])
    y = _mean_ranks([float(g) for _, g in pairs])
    mean = Fraction(len(pairs) + 1, 2)
    sxx = sum((a - mean) ** 2 for a in x)
    syy = sum((b - mean) ** 2 for b in y)
    for name, spread in (("predictions", sxx), ("gold values", syy)):
        if spread == 0:
            raise ValueError(f"spearman: the {name} are constant — rank correlation is undefined")
    sxy = sum((a - mean) * (b - mean) for a, b in zip(x, y))
    product = sxx * syy
    num, den = math.isqrt(product.numerator), math.isqrt(product.denominator)
    if num * num == product.numerator and den * den == product.denominator:
        return sxy / Fraction(num, den)
    return float(sxy) / math.sqrt(product)


SCORES = {"accuracy": _accuracy, "r2": _r2, "auc": _auc, "spearman": _spearman}


def deviation_rule(cfg: MeasureConfig) -> tuple[float, int, int] | None:
    """[quality-check-2]'s registered calibration rule (quantile,
    permutations, calibration seed) — None when the protocol registers none
    (`null_band_quantile`, `null_permutations`, `null_band_seed`;
    MeasureConfig refuses a part of it)."""
    q, k, s = cfg.null_band_quantile, cfg.null_permutations, cfg.null_band_seed
    return None if q is None or k is None or s is None else (float(q), int(k), int(s))


def deviation_by_rule(cfg: MeasureConfig, pairs: list[tuple], rule: tuple[float, int, int]) -> dict:
    """The calibration RULE (quantile q, permutations k, calibration seed s)
    applied to PAIRS (item, prediction, gold) with the predictions fixed:
    the pairs ordered by item, k permutations of the gold, each seeded
    `null-band:<s>:<n>` — never the run's seed —, scored as the registered
    lane is; the q quantile of |score − target| by its exact rank. The same
    pairs give the same result in any order. Returns {"target",
    "null_scores", "deviation", "rounded"}: TARGET the permutation expectation
    (`permutation_expectation`), DEVIATION the exact quantile, ROUNDED it
    rounded up to two places — the permitted deviation [quality-check-2]
    compares with. The one home of the rule: each evaluation
    (`run_null_band`) and the `--calibrate-null` preview call it.
    Predictions that score alike under every permutation — one answer for
    every item, or a gold of one value — give the deviation 0: the null
    check is exact. Raises ValueError for k < 1 or no pairs, when no item
    has a prediction, and at accuracy when no prediction is a gold value
    (labels from another vocabulary): those score alike too, but 0 there
    would hide a broken instrument. A score the predictions leave
    undefined (spearman on constant predictions) raises in the score."""
    q, k, seed = rule
    if k < 1 or not pairs:
        raise ValueError(f"deviation_by_rule(): {k} permutation(s) of {len(pairs)} labelled item(s)")
    if all(p is None for _, p, _ in pairs):
        raise ValueError(f"deviation_by_rule(): none of the {len(pairs)} labelled items has a prediction — "
                         "no permitted deviation from no answer; check the predictor's output")
    # the whole triple decides the order: ids that print alike (10 and "10",
    # a duplicate) must not leave it to the input's order
    ordered = sorted(pairs, key=lambda x: (str(x[0]), repr(x[1]), repr(x[2])))
    preds = [p for _, p, _ in ordered]
    golds = [g for _, _, g in ordered]
    target = permutation_expectation(cfg.score, list(zip(preds, golds)))
    scores = []
    for n in range(k):
        permuted = list(golds)
        random.Random(f"null-band:{seed}:{n}").shuffle(permuted)
        scores.append(SCORES[cfg.score](list(zip(preds, permuted))))
    off = sorted(abs(s - target) for s in scores)
    if off[-1] == 0 and cfg.score == "accuracy" and not set(preds) & set(golds):
        # 2026-10-29, apply-screen: predictions that matched no gold
        # registered null_band = 0.0 without a word
        raise ValueError(
            f"deviation_by_rule(): no prediction is a gold value — every one of {k} permutations "
            f"scores {float(target):.4f}; the predictions answer {sorted(map(repr, set(preds)))[:5]}, "
            f"the gold holds {sorted(map(repr, set(golds)))[:5]}. Check that the predictor "
            f"answers in the gold's labels")
    # the quantile's rank, exact: a float 0.99 * 200 may land on either side of 198
    deviation = off[max(0, math.ceil(Fraction(str(q)) * len(off)) - 1)]
    rounded = math.ceil(Fraction(deviation) * 100) / 100
    return {"target": target, "null_scores": scores, "deviation": deviation, "rounded": rounded}


def run_null_band(cfg: MeasureConfig, reg: list[dict]) -> float:
    """The permitted deviation of one run at apply with the seeded permuted
    null: the registered rule (`deviation_rule`) over the run's own registered
    rows REG (`deviation_by_rule`), rounded up. Raises ValueError when no rule is
    registered or the rule derives none."""
    rule = deviation_rule(cfg)
    if rule is None:
        raise ValueError("evaluate_rows(): at apply with the seeded permuted null [quality-check-2]'s "
                         "permitted deviation is computed per run — register null_band_quantile, "
                         "null_permutations and null_band_seed")
    return deviation_by_rule(cfg, [(r["item"], r["pred"], r["gold"]) for r in reg], rule)["rounded"]


def calibrate_null(cfg: MeasureConfig, items: list[dict]) -> dict:
    """A preview of the permitted deviation each run computes: the unchanged
    predictor's predictions on the labelled items, fixed, put through the
    registered rule (`deviation_by_rule`), as `run_null_band` does on the kept
    rows. It never scores a prediction against its true gold and registers
    nothing. Raises ValueError where the deviation is no permutation
    quantile (`null_plan`), without labelled items, or for a predictor
    returning the wrong number of answers."""
    if null_plan(cfg) != "per run":
        raise ValueError(
            "calibrate_null(): the permitted deviation is computed per run only at kind apply "
            "with the seeded permuted null; here it is a registered, reasoned null_band")
    rule = deviation_rule(cfg)
    assert rule is not None  # null_plan refuses a missing rule
    train = labelled(items)
    if not train:
        raise ValueError("calibrate_null(): no labelled item")
    preds = predict_all(make_estimator(cfg.seed), train, "calibrate_null()")
    return deviation_by_rule(cfg, [(it["id"], p, it[GOLD_FIELD]) for it, p in zip(train, preds)], rule)


def null_plan(cfg: MeasureConfig) -> str:
    """Where [quality-check-2]'s permitted deviation comes from: "per run" at
    kind apply with the seeded permuted null (no NULL_ORDER, no fixed null
    predictor), else "registered". Raises ValueError for a registration
    that contradicts it: per run with `null_band` registered or the rule
    incomplete; registered with the rule's constants (they would calibrate
    nothing), or without null_band where it is owed (fit, a fixed null
    predictor; a NULL_ORDER may go without one); [criterion-2] registered
    anywhere but per run (its comparison threshold needs the run's
    permutation quantile)."""
    per_run = KIND == "apply" and NULL_ORDER is None and make_null_predictor(cfg.seed) is None
    if per_run:
        if cfg.null_band is not None:
            raise ValueError("[quality-check-2] registers null_band, and at apply with the seeded "
                             "permuted null each run computes its permitted deviation by the registered "
                             "rule — drop null_band from its constants")
        if deviation_rule(cfg) is None:
            raise ValueError("[quality-check-2] registers no calibration rule: name null_band_quantile, "
                             "null_permutations and null_band_seed in its constants")
        return "per run"
    where = (f"kind {KIND}" if KIND != "apply" else
             "a registered NULL_ORDER" if NULL_ORDER is not None else "a fixed null predictor")
    if deviation_rule(cfg) is not None:
        raise ValueError(f"[quality-check-2] registers a calibration rule, and with {where} there is no "
                         "permutation spread of these predictions — register a reasoned null_band instead")
    if cfg.null_band is None and NULL_ORDER is None:
        raise ValueError(f"[quality-check-2] registers no null_band, and with {where} the permitted "
                         "deviation is a registered, reasoned value — register null_band")
    if cfg.chance_criterion:
        raise ValueError(f"[criterion-2] compares with a permutation quantile, and with {where} there "
                         "is none — drop [criterion-2] from the block")
    return "registered"


def null_check(cfg: MeasureConfig) -> None:
    """`null_plan` before the run opens, as SystemExit: evaluate_rows refuses
    the same registrations by the rows' shape, but only after every
    prediction is spent. Not covered here: predictions from which the rule
    derives no deviation (none at all, or none a gold value), which only
    the run's rows show."""
    try:
        null_plan(cfg)
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc


def chance_of(score: str, golds: list) -> Fraction:
    """The score an estimator that learned nothing is expected to reach, derived
    from the gold alone (LAB-037 Every anchor carries its target and rationale):
    accuracy — the sum of squared class shares (two independent draws from the
    label distribution agree that often; 1/2 on balanced binary gold);
    r2 — 0 (the mean explains nothing; a fitted forest sits slightly below);
    auc — 1/2 (a random ranking); spearman — 0 (an unrelated ranking)."""
    if score == "accuracy":
        n = len(golds)
        counts: dict = {}
        for g in golds:
            counts[g] = counts.get(g, 0) + 1
        return sum(Fraction(c, n) ** 2 for c in counts.values())
    if score == "r2":
        return Fraction(0)
    if score == "auc":
        return Fraction(1, 2)
    if score == "spearman":
        return Fraction(0)
    raise ValueError(f"chance_of(): no chance rule for score {score!r} — one of {', '.join(SCORES)}")


def permutation_expectation(score: str, pairs: list[tuple]) -> Fraction:
    """The score the predictions of PAIRS (prediction, gold) reach, on
    average, against their gold permuted uniformly — exact, no draw: each
    item's permuted label is distributed as the gold. accuracy — the sum
    over classes of the predictions' share times the gold's (a missing
    prediction is never correct); auc — 1/2; spearman — 0 (the gold's
    ranks keep their spread under a permutation, and each item's expected
    deviation is zero); r2 — −Σ(ŷ − ȳ)² / Σ(y − ȳ)²,
    since the total sum of squares does not move under a permutation (a
    missing prediction counts as the mean). [criterion-1]'s bar and [quality-check-2]'s target at
    apply with the permuted null: one permutation's draw put the bar
    anywhere between 0.54 and 0.78 on a screening model whose agreement
    is 0.76 (null-lane decision, 2026-10-28)."""
    if not pairs:
        raise ValueError("permutation_expectation(): no labelled items")
    n = len(pairs)
    if score == "accuracy":
        golds = Counter(g for _, g in pairs)
        preds = Counter(p for p, _ in pairs if p is not None)
        return sum((Fraction(preds[c], n) * Fraction(k, n) for c, k in golds.items()), Fraction(0))
    if score == "auc":
        return Fraction(1, 2)
    if score == "spearman":
        return Fraction(0)
    if score == "r2":
        ys = [Fraction(float(g)) for _, g in pairs]
        mean = sum(ys, Fraction(0)) / n
        sst = sum(((y - mean) ** 2 for y in ys), Fraction(0))
        if sst == 0:
            raise ValueError("r2: the gold values have no variance — nothing to explain")
        return -sum((((mean if p is None else Fraction(float(p))) - mean) ** 2 for p, _ in pairs),
                    Fraction(0)) / sst
    raise ValueError(f"permutation_expectation(): no rule for score {score!r} — one of {', '.join(SCORES)}")


def score_of(cfg: MeasureConfig, rows: list[dict]) -> tuple[Fraction | float, int]:
    """(score over every item of the lane, number of items without a prediction)."""
    pairs = [(r["pred"], r["gold"]) for r in rows]
    return SCORES[cfg.score](pairs), sum(1 for p, _ in pairs if p is None)


def scored_class_counts(rows: list[dict]) -> dict[str, int]:
    """Items per gold value over ROWS (one scored lane), keys as text in
    sorted order — JSON object keys are text, so the recomputation compares
    equal to metrics.json."""
    counts = Counter(str(r["gold"]) for r in rows)
    return {g: counts[g] for g in sorted(counts)}


def evaluate_rows(rows: list[dict], cfg: MeasureConfig = CONFIG) -> dict:
    """THE experiment, as a pure function of the stored rows and the config — gates first.

    Returns the kept number and every registered id's keys on every evaluation:
      KEPT_KEY                           the kept number: the registered lane's score, computed once
      quality_check_1_empty · quality_check_1_pass                 quality check: yield of the registered lane
      quality_check_2_score · quality_check_2_target · quality_check_2_pass     quality check: the null lane inside the null-check
                                         interval, its target ± the permitted deviation
                                         (apply, permuted null: the permutation expectation; else chance);
      quality_check_2_null_band          apply, seeded permuted null: the run's permitted deviation (`run_null_band`);
                                         at fit quality_check_2_score is the mean of the draws, quality_check_2_draw_scores each
      criterion_1_threshold · criterion_1_pass  only once the offered block below is uncommented:
                                         the kept score against cfg.at_least as
                                         registered, else the null value + cfg.margin
                                         (apply, permuted null: the permutation expectation; else the null)
      criterion_2_threshold · criterion_2_pass  only once the offered block below is uncommented:
                                         registered lane strictly above the comparison threshold,
                                         the permutation expectation + the run's permitted deviation
      n_items · n_rows · n_test          yield (→ LAB-023 No silent loss)
      scored_class_counts                accuracy/auc: items per gold value in the scored
                                         rows — not the class distribution of the input file
    A failed quality check reports its keys, the kept number, and no criterion verdict (`criterion_1_pass`, `criterion_2_pass` None).
    A number about the inputs the report states belongs in this dict, computed
    from the kept rows; one the rows cannot give owes rows that keep what it
    needs — never a count typed into the report."""
    if not rows:
        raise ValueError("evaluate_rows(): no rows — refusing a number over nothing")
    reg = [r for r in rows if r["lane"] == "registered"]
    null = [r for r in rows if r["lane"] == "null"]
    test = [r for r in rows if r["lane"] == "test"]
    if not reg or not null:
        raise ValueError("evaluate_rows(): both scored lanes must be in the same run (LAB-034 Null condition in the same run)")
    if any(r["gold"] is None for r in reg + null):
        raise ValueError("evaluate_rows(): a scored lane carries an item without gold — a withheld label is no label")
    reg_score, reg_empty = score_of(cfg, reg)
    # numbered draws (fit): the null's score is their mean, each kept
    draws: dict = {}
    for r in null:
        draws.setdefault(r.get("draw"), []).append(r)
    draw_scores = [score_of(cfg, draws[d])[0] for d in sorted(draws, key=str)]
    null_score = sum(draw_scores) / len(draw_scores)
    # a permuted null (its rows name the donor of their label): the bar and
    # [quality-check-2]'s target are the exact permutation expectation, the draw only the
    # anchor; a fitted or fixed null: chance is the target, its score the bar
    permuted = all("gold_of" in r for r in null)
    if permuted:
        target = permutation_expectation(cfg.score, [(r["pred"], r["gold"]) for r in reg])
    else:
        target = chance_of(cfg.score, [r["gold"] for r in reg])
    # the permitted deviation: the run's own by the registered rule at apply
    # with the seeded permuted null, else the registered, reasoned one; the
    # rows' shape decides, as null_plan does from the script before the run
    per_run = permuted and NULL_ORDER is None
    if per_run and cfg.null_band is not None:
        raise ValueError("evaluate_rows(): seeded permuted null rows, and [quality-check-2] registers "
                         "null_band — each run computes its permitted deviation by the registered rule")
    if not per_run and deviation_rule(cfg) is not None:
        raise ValueError("evaluate_rows(): [quality-check-2] registers a calibration rule, and these "
                         "null rows have no permutation spread of the predictions (fit, NULL_ORDER or "
                         "a fixed null predictor) — register a reasoned null_band")
    if not per_run and cfg.chance_criterion:
        raise ValueError("evaluate_rows(): [criterion-2] compares with a permutation quantile — only "
                         "the seed's permuted null at apply has one (no fit, NULL_ORDER or fixed null)")
    deviation = run_null_band(cfg, reg) if per_run else cfg.null_band
    if deviation is None and not (permuted and NULL_ORDER is not None):
        raise ValueError("evaluate_rows(): [quality-check-2] registers no null_band — only a "
                         "registered NULL_ORDER may go without one")
    within_deviation = deviation is None or abs(null_score - target) <= Fraction(str(deviation))
    metrics: dict = {KEPT_KEY: float(reg_score), "n_items": len(reg), "n_rows": len(rows), "n_test": len(test),
                     "quality_check_1_empty": reg_empty, "quality_check_1_pass": reg_empty <= cfg.max_empty,
                     "quality_check_2_score": float(null_score), "quality_check_2_target": float(target),
                     "quality_check_2_pass": within_deviation}
    if per_run:
        metrics["quality_check_2_null_band"] = deviation
    if len(draw_scores) > 1:
        metrics["quality_check_2_draw_scores"] = [float(s) for s in draw_scores]
    if cfg.score in ("accuracy", "auc"):
        metrics["scored_class_counts"] = scored_class_counts(reg)
    # read by the offered criterion blocks below: no verdict when a quality check fails
    gated = not (metrics["quality_check_1_pass"] and metrics["quality_check_2_pass"])
    # [criterion-2], offered: step 2 of 2 — uncomment the lines between the
    # markers once its table in the protocol is uncommented (step 1). Strict:
    # a score on the comparison threshold may tie the draw at its rank.
    # --- criterion-2 begin
    # chance_bar = target + Fraction(str(deviation))
    # metrics.update(criterion_2_threshold=float(chance_bar),
    #                criterion_2_pass=None if gated else reg_score > chance_bar)
    # --- criterion-2 end
    # [criterion-1], offered: step 2 of 2 — uncomment the lines between the
    # markers once its table in the protocol is uncommented (step 1). The bar
    # starts from the permutation expectation at apply with the seed's
    # permuted null, else from the null's score (a registered NULL_ORDER is
    # one fixed control); a bar the task states (at_least) is the bar as
    # registered. The verdict judges the kept score, the exact value stored
    # as float above.
    # --- criterion-1 begin
    # bar = criterion_bar.bar_of(cfg.at_least, cfg.margin, target if per_run else null_score)
    # metrics.update(criterion_1_threshold=None if gated else float(bar),
    #                criterion_1_pass=None if gated else reg_score >= bar)
    # --- criterion-1 end
    return metrics


def balance(out: Path, cfg: MeasureConfig, items: list[dict]) -> None:
    """Every expected row present once, no row the items do not ask for,
    every row from this instrument and these items — or SystemExit naming
    each gap, before any number (→ LAB-023 No silent loss). The rows then are
    the source's items, and every count `evaluate_rows` makes is a count of
    the source."""
    batch.Store(out).ledger(expected(items, cfg),
                            expect={"_instrument": instrument(cfg, items)}).require_complete()


def deliverable_rows(path: str, rows: list[dict], metrics: dict) -> list[dict]:
    """TODO (only with DELIVERABLES): the rows of the deliverable PATH, one
    dict per row with the task's columns as keys, in the task's order, from
    the kept ROWS (`lane` names the lane: the test lane's predictions for
    unlabelled items, the registered lane's for labelled ones) and the run's
    METRICS — never computed apart from them."""
    raise NotImplementedError(f"deliverable_rows(): the rows of {path} from rows and metrics")


def write_deliverables(run: runlog.Run, rows: list[dict], metrics: dict) -> None:
    """Write every DELIVERABLES file from the kept ROWS and METRICS
    (`deliverable_rows`), held to DELIVERABLE_COLUMNS (a column missing,
    unnamed or out of order is refused, nothing written), and register it
    with RUN: the run records its sha256 at the end, and `finalize` holds
    the file to that record. A repeat's draw (`run.draw`) writes none —
    supporting evidence, never the answer. Side effects: writes the files
    under REPO. No DELIVERABLES: nothing."""
    if run.draw is not None:
        return
    for path in DELIVERABLES:
        run.output(deliverable.write_csv(REPO / path, deliverable_rows(path, rows, metrics),
                                         DELIVERABLE_COLUMNS))


def evaluate(out: Path, cfg: MeasureConfig, items: list[dict], run=None) -> dict:
    """Balance the kept rows against ITEMS, then gates first, then the metrics on the run."""
    balance(out, cfg, items)
    metrics = evaluate_rows(read_jsonl(out), cfg)
    shown = (KEPT_KEY, "quality_check_1_pass", "quality_check_1_empty", "quality_check_2_score",
             "quality_check_2_target", "quality_check_2_null_band", "quality_check_2_pass")
    # an offered criterion's keys, once its block is uncommented, by prefix:
    # a key literal here would read as reported where it is not registered
    for key in shown + tuple(k for k in metrics if k.startswith("criterion_") and k not in shown):
        if key in metrics:  # quality_check_2_null_band: apply with the seeded permuted null only
            print(f"  {key:<13} {metrics[key]}")
    if run is not None:
        run.metrics(**metrics)
    return metrics


def main() -> None:
    ap = argparse.ArgumentParser(description=(__doc__ or "").splitlines()[0])
    ap.add_argument("--seed", type=int, default=None,
                    help="folds, permutation, estimator (default: CONFIG's — the registered seed, "
                         "else SEED); a full run with it answers")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--show", type=int, metavar="N", help="the config and N feature rows per split, no fit")
    mode.add_argument("--probe", type=int, nargs="?", const=12, metavar="N",
                      help="instrument check: N labelled items, both lanes; fit uses a reduced "
                           "estimator, apply its unchanged predictors; "
                           "throwaway output; prints the scores (not reported) and one row per lane")
    mode.add_argument("--calibrate-null", action="store_true",
                      help="apply, seeded permuted null: a preview of the permitted deviation each "
                           "run computes by the registered rule (null_band_quantile over "
                           "null_permutations, seeded by null_band_seed) from the predictions "
                           "on the labelled items; no run, nothing written")
    mode.add_argument("--eval-only", action="store_true")
    mode.add_argument("--repeat-of", metavar="RUN_ID",
                      help="draw the kept run RUN_ID again with a derived seed: a run of its own "
                           "(repeat_of) into <out>_draw<N>.jsonl — the spread, never the answer")
    args = ap.parse_args()
    if args.repeat_of is not None and args.seed is not None:
        ap.error("--repeat-of takes the kept run's config and derives its seed; drop --seed")
    head = protocol_block.head(PROTOCOL.read_text(encoding="utf-8"))
    if args.probe is not None and not standard_contract.lane(head.repeat_cost).probe_allowed:
        ap.error("--probe is not available at repeat_cost='low'; run the full measurement")
    # the one field the command line may set
    cfg = replace(CONFIG, predictor_sha=predictor_digests())
    if args.seed is not None:
        cfg = replace(cfg, seed=args.seed)
    items = read_jsonl(ITEMS)

    if args.show is not None:          # `is not None`: `--show 0` must not start a run
        print("===== config (what a run writes to config.json)")
        for key, value in asdict(cfg).items():
            print(f"  {key:<16} {value}")
        for split, part in (("train", labelled(items)), ("test", unlabelled(items))):
            print(f"===== {split}: {len(part)} items")
            for it in part[:args.show]:
                print(json.dumps(it, ensure_ascii=False)[:200])
        return

    if args.calibrate_null:
        try:
            cal = calibrate_null(cfg, items)
        except ValueError as exc:
            ap.error(str(exc))
        q, k, seed = deviation_rule(cfg) or (None, None, None)
        s = sorted(float(x) for x in cal["null_scores"])
        print(f"null over {len(s)} permutations of the gold, predictions fixed: min {s[0]:.4f}  "
              f"median {s[len(s) // 2]:.4f}  max {s[-1]:.4f}  permutation expectation "
              f"{float(cal['target']):.4f}")
        print(f"permitted deviation by the rule (the {q} quantile of |null - expectation| over "
              f"{k} permutations, calibration seed {seed}): {float(cal['deviation']):.4f}, rounded up "
              f"{cal['rounded']} — a preview: each run computes it from its own predictions "
              f"and keeps it as quality_check_2_null_band")
        return

    if args.probe is not None:
        # Throwaway: own output file, NO runlog (LAB-008 Instrument check before freezing) — the moment a
        # number is kept, it is a run. Few items, reduced fit or unchanged apply: the
        # pipeline is checked, the registered number is not seen.
        out = OUT.with_name(OUT.stem + "_probe.jsonl")
        out.unlink(missing_ok=True)  # a fresh file each probe: its items may have changed
        few = labelled(items)[:args.probe] + unlabelled(items)[:5]
        rows = measure(cfg, few, out, probe=True)
        m = evaluate_rows(rows, cfg)
        print(f"probe: registered {m[KEPT_KEY]}  null {m['quality_check_2_score']}  target {m['quality_check_2_target']}  — not reported")
        print("\n# one row per lane, as the run will keep them (Raw output comes from the run):")
        for lane in LANES:
            first = next((r for r in rows if r["lane"] == lane), None)
            if first is not None:
                print(json.dumps(first, ensure_ascii=False))
        return

    if args.eval_only:
        evaluate(OUT, cfg, items)
        return

    # The whole config, never a hand-picked subset. run_kind="measurement" declares the
    # full run: at high repeat cost the protocol must be frozen with the
    # preflight audit stamped and the run detached (`runlog start <area> -- …`).
    # `data=` freezes the items in the run.
    # A repeat (`--repeat-of`): runlog holds every key but the seed to the
    # kept run's, derives the seed from that run and the draw and records it
    # (`reseed`) — the seed passed here is not used.
    # where the permitted deviation comes from, and criterion-2's precondition,
    # before the run opens
    null_check(cfg)
    budget_s, budget_note = timebox.seconds_of(PROTOCOL.read_text(encoding="utf-8"))
    print(f"fit plan: {cfg.n_folds} folds × (1 + {cfg.null_refits}) fits at repeat_cost {HEAD.repeat_cost!r}; {budget_note}"
          if KIND == "fit" else budget_note)
    with runlog.run("<name>", config=asdict(cfg), base_dir=AREA, data=data_files(),
                    run_kind="measurement", protocol=PROTOCOL.name,
                    repeat_of=args.repeat_of, reseed=args.repeat_of is not None) as run:
        cfg = MeasureConfig(**run.config)   # measure with what is recorded
        out = run.draw_output(OUT)
        run.output(out)
        rows = measure(cfg, items, out, prov={"run": run.run_id}, budget_s=budget_s)
        metrics = evaluate(out, cfg, items, run)
        write_deliverables(run, rows, metrics)
        if run.draw is None:
            print(f"run: {run.run_id}\n" + next_after_run(PROTOCOL, run.run_id))
        else:
            print(f"run: {run.run_id}  draw {run.draw} of {args.repeat_of}, seed {cfg.seed} — "
                  f"supporting evidence, never the answer: `scripts/02_analyze.py --draws`")


if __name__ == "__main__":
    main()
