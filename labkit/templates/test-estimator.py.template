"""`<area>`: the resolution check as a permanent test (LAB-016 Resolution check before freezing).

    .venv/bin/python -m pytest tests/test_<NN>_<name>.py

Imports the area's script by path under a unique name (two areas in one
pytest run must not share `01_measure`) and never copies its formula; the
estimator itself is not needed here, only `evaluate_rows()`. The check runs
it on synthetic rows in the run's real shape — perfect effect fires [criterion-1], a
null-like registered lane stays silent, missing predictions fail [quality-check-1] and
withhold the verdict, a null lane off its target fails [quality-check-2] where it
registers a band. When the script registers a null order (`NULL_ORDER`, apply)
the null rows name the donor of their label (`gold_of`) as the run's do: the
bar is then the null's score plus margin, and a band is owed only where
[quality-check-2] registers one. [criterion-1]'s bar is held in both forms,
whichever the protocol registers: `at_least`, a bar the task states, is the
bar as written whatever the null scores; `margin` a lead over the null. The rows below
serve SCORE = "accuracy" (two labels), "auc" (0/1 gold, a score per item:
0.9 ranks an item as positive, 0.1 as negative, so twelve items with `correct`
of them right score correct/12 under both) and "spearman" (gold 0 … 11; a
wrong item predicts the mirrored value 11 − gold, so all right is rho 1 and
six right rho 0, exactly); TODO when the score is r2: write the cases with
float golds — `test_the_score_has_cases_here` fails until then.
"""
from __future__ import annotations

import importlib.util
import sys
from pathlib import Path

import pytest

AREA = Path(__file__).resolve().parent.parent / "<area>"
_spec = importlib.util.spec_from_file_location("measure_<NN>_<name>", AREA / "scripts" / "01_measure.py")
assert _spec is not None and _spec.loader is not None
measure = importlib.util.module_from_spec(_spec)
sys.modules[_spec.name] = measure
_spec.loader.exec_module(measure)

SCORE = measure.CONFIG.score
#: the two classes' gold: labels at accuracy, 1 and 0 at auc
POS, NEG = ("pos", "neg") if SCORE == "accuracy" else (1, 0)
#: the twelve items' gold: half of each class, at spearman the values 0 … 11
GOLDS = [float(i) for i in range(12)] if SCORE == "spearman" else [POS] * 6 + [NEG] * 6
#: a registered null order: its null rows carry `gold_of`, its band is optional
ORDERED_NULL = measure.NULL_ORDER is not None
#: [criterion-1] registers a bar the task states (`at_least`), not a lead over the null (`margin`)
ABSOLUTE = measure.CONFIG.at_least is not None


def predicted(right: bool, gold):
    """The prediction for an item of class GOLD, RIGHT or not: the label at
    accuracy; at auc a score, 0.9 when it ranks the item as positive; at
    spearman the gold value, or its mirror 11 − GOLD when wrong."""
    if SCORE == "accuracy":
        return gold if right else (NEG if gold == POS else POS)
    if SCORE == "spearman":
        return gold if right else 11.0 - gold
    return 0.9 if (gold == POS) == right else 0.1


def test_the_score_has_cases_here():
    assert SCORE in ("accuracy", "auc", "spearman"), (
        f"SCORE = {SCORE!r}: write this test's cases for it (float golds for r2)")


def rows(registered: list[tuple], null: list[tuple], test: int = 0) -> list[dict]:
    """Synthetic kept rows in the run's shape: (pred, gold) per scored lane,
    plus TEST rows of the test lane (a prediction, no gold). Under a registered
    null order each null row names the item whose label it carries (`gold_of`),
    as `apply_rows` writes it."""
    out = []
    for lane, pairs in (("registered", registered), ("null", null)):
        for i, (pred, gold) in enumerate(pairs):
            donor = {"gold_of": str(i)} if lane == "null" and ORDERED_NULL else {}
            out.append({"id": f"{lane}:{i}", "lane": lane, "item": str(i), "fold": 0,
                        "pred": pred, "gold": gold, **donor})
    out += [{"id": f"test:{i}", "lane": "test", "item": f"t{i}", "fold": None,
             "pred": predicted(True, POS), "gold": None} for i in range(test)]
    return out


def _twelve(correct: int) -> list[tuple]:
    """Twelve items (GOLDS), the first `correct` of them predicted right."""
    return [(predicted(i < correct, g), g) for i, g in enumerate(GOLDS)]


def test_perfect_effect_fires_c1():
    m = measure.evaluate_rows(rows(_twelve(12), _twelve(6)))
    assert m["criterion_1_pass"] is True and m["quality_check_2_pass"] is True and m["quality_check_1_pass"] is True


def test_null_like_registered_lane_stays_silent():
    m = measure.evaluate_rows(rows(_twelve(6), _twelve(6)))
    assert m["criterion_1_pass"] is False


def test_chance_is_derived_from_the_gold():
    """Balanced binary gold: two draws agree half the time."""
    assert measure.chance_of("accuracy", [POS] * 6 + [NEG] * 6) == 0.5
    assert measure.chance_of("auc", [1, 0]) == 0.5 and measure.chance_of("r2", [1.0, 2.0]) == 0.0
    assert measure.chance_of("spearman", [1.0, 2.0]) == 0


def test_missing_predictions_withhold_the_verdict():
    max_empty = measure.CONFIG.max_empty
    reg = [(None, g) for _, g in _twelve(12)[: max_empty + 1]] + _twelve(12)[max_empty + 1:]
    m = measure.evaluate_rows(rows(reg, _twelve(6)))
    assert m["quality_check_1_pass"] is False and m["criterion_1_pass"] is None


def test_null_out_of_band_withholds_the_verdict():
    """A registered band: a null lane far off its target withholds the verdict.
    A registered null order without a band: there is no band to leave, and
    the null's score raises the bar past the registered lane."""
    m = measure.evaluate_rows(rows(_twelve(12), _twelve(12)))
    if measure.CONFIG.null_band is None:
        assert m["quality_check_2_pass"] is True and m["criterion_1_pass"] is False
    else:
        assert m["quality_check_2_pass"] is False and m["criterion_1_pass"] is None


def test_only_a_registered_null_order_goes_without_a_band():
    """[quality-check-2] owes a band unless the script registers a null order
    and the null rows name their donors: then the null's score plus margin
    is the bar. Null rows without donors — every null row when no order is
    registered — are refused without a band."""
    from dataclasses import replace

    no_band = replace(measure.CONFIG, null_band=None)
    kept = rows(_twelve(12), _twelve(6))
    without_donors = [{k: v for k, v in r.items() if k != "gold_of"} for r in kept]
    with pytest.raises(ValueError, match="registers no null_band"):
        measure.evaluate_rows(without_donors, no_band)
    if ORDERED_NULL:
        m = measure.evaluate_rows(kept, no_band)
        bar = no_band.at_least if ABSOLUTE else m["quality_check_2_score"] + no_band.margin
        assert m["criterion_1_threshold"] == pytest.approx(bar)
        assert m["quality_check_2_pass"] is True and m["criterion_1_pass"] is True


def test_the_test_lane_is_counted_never_scored():
    m = measure.evaluate_rows(rows(_twelve(12), _twelve(6), test=5))
    assert m["n_test"] == 5 and m["n_items"] == 12 and m["criterion_1_pass"] is True


def test_class_counts_are_the_scored_items_per_gold():
    """Checked by hand: seven pos and five neg in the scored lane, three test
    items without gold — the counts are 7 and 5; the test lane is no class.
    At spearman the gold is a value, not a class: no counts are stored.
    TODO when the score is r2: drop this test, r2 stores no class counts."""
    if SCORE == "spearman":
        m = measure.evaluate_rows(rows(_twelve(12), _twelve(6), test=3))
        assert "scored_class_counts" not in m and m["n_items"] == 12 and m["n_test"] == 3
        return
    golds = [POS] * 7 + [NEG] * 5
    reg = [(predicted(True, g), g) for g in golds]
    m = measure.evaluate_rows(rows(reg, [(predicted(True, POS), g) for g in golds], test=3))
    assert m["scored_class_counts"] == {str(NEG): 5, str(POS): 7}
    assert m["n_items"] == 12 and m["n_test"] == 3


def test_a_scored_lane_without_gold_is_refused():
    """A withheld label stored as 0 or -999 is no label: the prepare step writes
    null, and a scored lane carrying one is a refusal, never a number."""
    reg = _twelve(12)
    reg[0] = (predicted(True, POS), None)
    with pytest.raises(ValueError, match="without gold"):
        measure.evaluate_rows(rows(reg, _twelve(6)))


def test_the_formula_reads_its_thresholds_from_the_config():
    """The run records `asdict(CONFIG)`; this holds that the formula reads the
    same object — a threshold moved there moves the verdict."""
    from dataclasses import asdict, fields, replace

    from labkit.formats import promises

    assert set(asdict(measure.CONFIG)) == {f.name for f in fields(measure.MeasureConfig)}
    registered = promises.all_constants(promises.load(measure.PROTOCOL))
    assert registered and all(asdict(measure.CONFIG)[k] == v for k, v in registered.items())
    # past every score's reach (from its null)
    strict = replace(measure.CONFIG, at_least=1.5) if ABSOLUTE else replace(measure.CONFIG, margin=1.5)
    assert measure.evaluate_rows(rows(_twelve(12), _twelve(6)), strict)["criterion_1_pass"] is False
    assert measure.evaluate_rows(rows(_twelve(12), _twelve(6)))["criterion_1_pass"] is True


def test_a_lane_exactly_at_null_plus_margin_passes():
    """8/12 against 5/12 + 0.25 is exactly the bar (accuracy and auc alike,
    `predicted`), at spearman rho 1 against 0 + 1: in floats it fell one ulp
    short (2026-10-14); the scores are exact, so it passes."""
    from dataclasses import replace

    margin, at, below, null = (1.0, 12, 11, 6) if SCORE == "spearman" else (0.25, 8, 7, 5)
    cfg = replace(measure.CONFIG, at_least=None, margin=margin, null_band=0.25)
    assert measure.evaluate_rows(rows(_twelve(at), _twelve(null)), cfg)["criterion_1_pass"] is True
    assert measure.evaluate_rows(rows(_twelve(below), _twelve(null)), cfg)["criterion_1_pass"] is False


def test_a_lane_exactly_at_the_stated_bar_passes_whatever_the_null():
    """`at_least`, a bar the task states, is the bar as written: 9/12
    against 0.75 passes and 8/12 fails with the null lane at 5 or 7 of 12
    (at spearman rho 1 against 1.0 passes and eleven of twelve right fails,
    the null at rho 0) — the null moves [quality-check-2], never the bar."""
    from dataclasses import replace

    bar, at, below = (1.0, 12, 11) if SCORE == "spearman" else (0.75, 9, 8)
    cfg = replace(measure.CONFIG, margin=None, at_least=bar, null_band=0.25)
    for null in (6,) if SCORE == "spearman" else (5, 7):
        m = measure.evaluate_rows(rows(_twelve(at), _twelve(null)), cfg)
        assert m["criterion_1_threshold"] == bar and m["criterion_1_pass"] is True
        assert measure.evaluate_rows(rows(_twelve(below), _twelve(null)), cfg)["criterion_1_pass"] is False


def test_criterion_1_registers_exactly_one_bar():
    """Both forms or neither are refused before any row is read: a task's bar
    beside a margin would leave the verdict to whichever the code reads."""
    from dataclasses import replace

    with pytest.raises(ValueError, match="both `at_least` and `margin`"):
        replace(measure.CONFIG, at_least=0.9, margin=0.25)
    with pytest.raises(ValueError, match="neither `at_least` nor `margin`"):
        replace(measure.CONFIG, at_least=None, margin=None)
