"""`<area>`: the resolution check and the parser cases, as a permanent test.

    .venv/bin/python -m pytest tests/test_<NN>_<name>.py

Imports the area's script by path under a unique name (two areas in one
pytest run must not share `01_measure`) and never copies its formula. The
resolution check runs `evaluate_rows()` on synthetic rows in the run's real
shape — perfect effect fires [criterion-1], a null-like registered lane stays silent,
too many empty answers fail [quality-check-1] and withhold the verdict, the registered
null band holds the null lane symmetric around chance. [criterion-1]'s bar is
held in both forms, whichever the protocol registers: `at_least`, a bar the
task states, is the bar as written whatever the null lane answers; `margin`
a lead over the null lane's accuracy. The parser cases
are the canonical answer forms plus the forms `--probe` prints (pasteable);
until those are pasted the probe test is a TODO, except at repeat_cost = low.
"""
from __future__ import annotations

import importlib.util
import sys
from pathlib import Path

import pytest

AREA = Path(__file__).resolve().parent.parent / "<area>"
_spec = importlib.util.spec_from_file_location("measure_<NN>_<name>", AREA / "scripts" / "01_measure.py")
assert _spec is not None and _spec.loader is not None
measure = importlib.util.module_from_spec(_spec)
sys.modules[_spec.name] = measure
_spec.loader.exec_module(measure)

POS, NEG, *_ = list(measure.ANSWERS.values())  # two gold labels, from the one constant
YES, NO, *_ = list(measure.ANSWERS)             # their answer words
#: [criterion-1] registers a bar the task states (`at_least`), not a lead over the null (`margin`)
ABSOLUTE = measure.CONFIG.at_least is not None


def rows(registered: list[tuple[str, str]], null: list[tuple[str, str]]) -> list[dict]:
    """Synthetic kept rows in the run's shape: (answer, gold) per lane."""
    out = []
    for lane, pairs in (("registered", registered), ("null", null)):
        for i, (answer, gold) in enumerate(pairs):
            out.append({"id": f"{lane}:{i}", "lane": lane, "answer": answer, "gold": gold})
    return out


def _lane(n: int, correct: int) -> list[tuple[str, str]]:
    """`n` items (even), `correct` of them answered right, half of each gold label."""
    golds = [POS] * (n // 2) + [NEG] * (n // 2)
    words = {POS: YES, NEG: NO}
    other = {POS: NO, NEG: YES}
    return [(words[g] if i < correct else other[g], g) for i, g in enumerate(golds)]


def _twelve(correct: int) -> list[tuple[str, str]]:
    """Twelve items, `correct` of them answered right, half of each gold label."""
    return _lane(12, correct)


def _band_lane() -> int:
    """How many items a null lane needs so that the REGISTERED band
    (`null_band_items`, your number, not the stamp's) has an item outside it
    on both sides: twelve, more for a band wider than four."""
    return max(12, 2 * measure.CONFIG.null_band_items + 4)


def test_perfect_effect_fires_c1():
    m = measure.evaluate_rows(rows(_twelve(12), _twelve(6)))
    assert m["criterion_1_pass"] is True and m["quality_check_2_pass"] is True and m["quality_check_1_pass"] is True


def test_null_band_is_symmetric_at_the_registered_band():
    """Chance ± the registered band: chance − band, chance and chance + band
    correct are in, one item further on either side is out — at band 1 on
    twelve items 5, 6 and 7 in, 4 and 8 out. In shares, 7/12 fell out by
    floating point (2026-10-06)."""
    band, n = measure.CONFIG.null_band_items, _band_lane()
    chance = n // 2
    for correct, inside in ((chance - band - 1, False), (chance - band, True), (chance, True),
                            (chance + band, True), (chance + band + 1, False)):
        m = measure.evaluate_rows(rows(_lane(n, n), _lane(n, correct)))
        assert m["quality_check_2_pass"] is inside, correct


def test_null_like_registered_lane_stays_silent():
    m = measure.evaluate_rows(rows(_twelve(6), _twelve(6)))
    assert m["criterion_1_pass"] is False


def test_too_many_empty_answers_withhold_the_verdict():
    max_empty = measure.CONFIG.max_empty
    reg = [("", g) for _, g in _twelve(12)[: max_empty + 1]] + _twelve(12)[max_empty + 1:]
    m = measure.evaluate_rows(rows(reg, _twelve(6)))
    assert m["quality_check_1_pass"] is False and m["criterion_1_pass"] is None


def test_the_formula_reads_its_thresholds_from_the_config():
    """The run records `asdict(CONFIG)`; this holds that the formula reads the
    same object — a threshold moved there moves the verdict, so no stray
    constant decides a number the record does not carry."""
    from dataclasses import asdict, fields, replace

    from labkit.formats import promises

    assert set(asdict(measure.CONFIG)) == {f.name for f in fields(measure.MeasureConfig)}
    # every registered constant is a field, read from the block, not copied
    registered = promises.all_constants(promises.load(measure.PROTOCOL))
    assert registered and all(asdict(measure.CONFIG)[k] == v for k, v in registered.items())
    # past the reach of twelve right (over a null of six)
    strict = replace(measure.CONFIG, at_least=1.5) if ABSOLUTE else replace(measure.CONFIG, margin=0.9)
    assert measure.evaluate_rows(rows(_twelve(12), _twelve(6)), strict)["criterion_1_pass"] is False
    assert measure.evaluate_rows(rows(_twelve(12), _twelve(6)))["criterion_1_pass"] is True


def test_an_empty_answer_counts_as_not_correct():
    """Accuracy is over every item: two empty answers on twelve are 10/12, not
    10/10 — a model must not gain accuracy by not answering."""
    reg = _twelve(12)[:10] + [("", g) for _, g in _twelve(12)[10:]]
    m = measure.evaluate_rows(rows(reg, _twelve(6)))
    assert m["quality_check_1_empty"] == 2 and m["criterion_1_accuracy"] == 10 / 12


def test_a_constant_placebo_sits_at_its_gold_share():
    """Chance is what the null lane's own answers reach against its gold
    permuted: a placebo answered the same on every item sits exactly at the
    gold count of that answer's class, also on unbalanced gold — two thirds
    of the items one label, far outside any band around half."""
    n = 3 * _band_lane()
    golds = [POS] * (2 * n // 3) + [NEG] * (n // 3)
    m = measure.evaluate_rows(rows(_lane(12, 12), [(YES, g) for g in golds]))
    assert m["quality_check_2_pass"] is True and m["quality_check_2_expected"] == 2 / 3


def test_null_out_of_band_withholds_the_verdict():
    n = _band_lane()  # every item right lies outside the registered band
    m = measure.evaluate_rows(rows(_lane(n, n), _lane(n, n)))
    assert m["quality_check_2_pass"] is False and m["criterion_1_pass"] is None


# The forms the answer line asks for — the parser must read them before any
# call. The forms the model really writes come on top: `--probe` prints them
# pasteable (at repeat_cost = low the first run is the probe, 2026-10-07).
CANONICAL_CASES: list[tuple[str, str | None]] = [
    (YES, POS),
    (YES + ".", POS),
    (YES.upper(), POS),
    ("**" + YES + "**", POS),
    ("*" + NO + "*.", NEG),
    (NO, NEG),
    (NO + "\nBecause the text says otherwise.", NEG),
    ("", None),
]
PROBE_CASES: list[tuple[str, str | None]] = [
    # TODO: paste the lines `--probe` prints
]
PARSER_CASES = CANONICAL_CASES + PROBE_CASES


# TODO: one rule per class [criterion-…] speaks of — the class follows from the
# facts, never from the list it stands in. Delete with the block in 01_measure.py.
CLASS_RULE = {
    # "over_ceiling": lambda f: f["hotel_eur"] > f["ceiling_eur"],
    # "within": lambda f: f["hotel_eur"] <= f["ceiling_eur"],
}


def test_every_case_class_follows_from_its_facts():
    cases = measure.read_case_classes()
    if not cases:
        pytest.skip("no case_classes.toml — the criterion names no case classes")
    missing = {c.cls for c in cases} - set(CLASS_RULE)
    assert not missing, f"TODO: a rule for every class: {sorted(missing)}"
    wrong = [c.id for c in cases if not CLASS_RULE[c.cls](c.facts)]
    assert wrong == [], f"in a class their facts contradict: {wrong}"
    assert set(measure.one_per_class()) <= {c.id for c in cases}


def test_probe_cases_are_pasted():
    """Owed before a high repeat cost run (LAB-014 One fully rendered example pair per gold class). At repeat_cost = low no probe
    precedes the run, so the canonical forms carry the test until then."""
    from labkit.formats import protocol_block, standard_contract

    head = protocol_block.head(measure.PROTOCOL.read_text(encoding="utf-8"))
    if not standard_contract.lane(head.repeat_cost).probe_allowed:
        pytest.skip("repeat_cost = low: no probe before the run; canonical forms only")
    assert PROBE_CASES, "TODO: paste the parser cases that `--probe` prints into PROBE_CASES"


@pytest.mark.parametrize("raw,expected", PARSER_CASES)
def test_parser_reads_the_probe_forms(raw, expected):
    assert measure.parse_answer(raw) == expected


def test_a_lane_exactly_at_null_plus_margin_passes():
    """8/12 against 5/12 + 0.25 is exactly the bar and passes, 7/12 fails:
    in floats a lane exactly at null + margin failed by one ulp."""
    from dataclasses import replace

    cfg = replace(measure.CONFIG, at_least=None, margin=0.25, null_band_items=1)
    assert measure.evaluate_rows(rows(_twelve(8), _twelve(5)), cfg)["criterion_1_pass"] is True
    assert measure.evaluate_rows(rows(_twelve(7), _twelve(5)), cfg)["criterion_1_pass"] is False


def test_a_lane_exactly_at_the_stated_bar_passes_whatever_the_null():
    """`at_least`, a bar the task states, is the bar as written: 9/12
    against 0.75 passes and 8/12 fails, with the null lane at 5 or 7 of 12 —
    the null moves [quality-check-2], never the bar."""
    from dataclasses import replace

    cfg = replace(measure.CONFIG, margin=None, at_least=0.75, null_band_items=1)
    for null in (5, 7):
        m = measure.evaluate_rows(rows(_twelve(9), _twelve(null)), cfg)
        assert m["criterion_1_threshold"] == 0.75 and m["criterion_1_pass"] is True
        assert measure.evaluate_rows(rows(_twelve(8), _twelve(null)), cfg)["criterion_1_pass"] is False


def test_criterion_1_registers_exactly_one_bar():
    """Both forms or neither are refused before any row is read: a task's bar
    beside a margin would leave the verdict to whichever the code reads."""
    from dataclasses import replace

    with pytest.raises(ValueError, match="both `at_least` and `margin`"):
        replace(measure.CONFIG, at_least=0.9, margin=0.25)
    with pytest.raises(ValueError, match="neither `at_least` nor `margin`"):
        replace(measure.CONFIG, at_least=None, margin=None)
