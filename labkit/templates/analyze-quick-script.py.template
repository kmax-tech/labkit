#!/usr/bin/env python3
"""Hold the counted number to its own rows — one formula, imported, never copied.

    ../../.venv/bin/python scripts/02_analyze.py            # the number, recomputed from OUT
    ../../.venv/bin/python scripts/02_analyze.py --check    # pin OUT to the run, recompute, hold the protocol to it
    ../../.venv/bin/python scripts/02_analyze.py --check --protocol PROTOCOL-<name>.md   # as report-check runs it
    ../../.venv/bin/python scripts/02_analyze.py --check --run <run_id>   # an older run, under the text it started under; releases nothing

The one public recheck of every area (`report-check` runs it when the number
is written back, LAB-041 Generate numbers, don't retype them), for one
protocol at a time: the one `--protocol` names, else the area's only one —
an area of several protocols owes the name. Every call, the plain one
too, first takes the protocol, the run that answers it and that run's
script, and ends with the reason where one of them is missing. `labkit.checks.recheck.holds`
pins the output file to the run's recorded sha, recomputes `metrics.json`
from the kept rows and holds the protocol to every number and the run_id.
A run that reads another run's output is recomputed from its recorded
inputs as well (`recheck.verified_from_inputs`, `01_measure.metrics_from_inputs`);
a run whose code changed since it ran is refused, not recomputed; where
nothing shows that the code here is the code the run ran, the check ends
"not verifiable" — a missing proof, and report-check holds the release on it.
The formula is the one of the script the held run ran, imported
(`recheck.script_module`: `01_measure.py`, or the script of its own a
second protocol of the area is computed by) — a second copy here would be
a second truth of the number, and another protocol's script another
number's formula. That script defines `OUT`, `expected_ids`, `metrics_of`
and `metrics_from_inputs` as `01_measure.py` does; the metrics recomputed
are its `metrics_of`'s, the formula and, where the head registers a
`[reference]`, the verdict against it, so the check holds the comparison
too.
"""
from __future__ import annotations

import argparse
import json
from pathlib import Path

from labkit.checks import recheck

AREA = Path(__file__).resolve().parent.parent


def main() -> None:
    ap = argparse.ArgumentParser(description=(__doc__ or "").splitlines()[0])
    ap.add_argument("--check", action="store_true",
                    help="pin OUT to the run, recompute from its rows, hold the protocol to it")
    ap.add_argument("--protocol", metavar="FILE",
                    help="the protocol to hold, by file name — owed where the area has several")
    ap.add_argument("--run", metavar="RUN_ID",
                    help="with --check: an older run of that protocol instead of the answering one, held under the "
                         "protocol text it started under; its rows are read from the commit that holds them where a "
                         "later run overwrote the file. Releases nothing")
    args = ap.parse_args()
    if args.run and not args.check:
        ap.error("--run names an older run for --check")
    protocol = recheck.protocol_named(AREA, args.protocol)
    run = recheck.run_dir(AREA, protocol, args.run)   # the run that protocol answers with, or the older one named
    measure = recheck.script_module(AREA, run)   # the script that run ran: its formula, no other protocol's
    ids = measure.expected_ids()   # the denominator comes from the source, never from the rows
    if args.run:
        # the separate check of an older run: no note is held and nothing
        # is released — the protocol's number is held by `--check` alone
        h = recheck.holds_as_measured(area=AREA, out=measure.OUT, recompute=lambda rows: measure.metrics_of(rows, ids),
                                      run_id=args.run, protocol=protocol)
        from_inputs = recheck.reads_another_run(run)
        if from_inputs:
            recheck.verified_from_inputs(run, AREA, measure.metrics_from_inputs, hold_block_now=False)
        print(f"historical check: run {h.run_id} of {protocol.name}, under the text it started under — "
              f"{h.keys_compared} keys identical; rows read from {h.source}"
              + ("; recomputed from its recorded inputs, the same numbers" if from_inputs else "")
              + "; this releases nothing" + (f"; grown since the run: {h.grown}" if h.grown else ""))
        return
    if args.check:
        # the numbers as protocol-fill --from-run writes them (recheck.plain_numbers)
        v = recheck.holds(area=AREA, out=measure.OUT, recompute=lambda rows: measure.metrics_of(rows, ids),
                          note=protocol)
        # a run that computes from another run's output (an input with an
        # origin run) is recomputed from those inputs too: its rows alone
        # would hold the number to a file this run wrote itself. The code
        # step ran inside holds() above (changed code and code that cannot
        # be compared end the check there) and runs again here
        from_inputs = recheck.reads_another_run(run)
        if from_inputs:
            recheck.verified_from_inputs(run, AREA, measure.metrics_from_inputs)
        print(f"check: run {v.run_id} of {protocol.name} — {v.keys_compared} keys identical, "
              f"{protocol.name} carries them and the run_id"
              + ("; recomputed from its recorded inputs, the same numbers" if from_inputs else "")
              + (f"; grown since the run: {v.grown}" if v.grown else ""))
        return
    print(json.dumps(measure.metrics_of(recheck.rows_of(measure.OUT), ids), indent=1))


if __name__ == "__main__":
    main()
