#!/usr/bin/env python3
"""<name>: one question, one number — kept through runlog, rechecked from its rows.

    ../../.venv/bin/python scripts/01_measure.py            # count, keep, print the number + run_id
    ../../.venv/bin/runlog start . -- ../../.venv/bin/python scripts/01_measure.py   # the same, detached (high repeat cost)
    ../../.venv/bin/python scripts/02_analyze.py --check    # recompute from the kept rows; hold metrics.json and the protocol to it

The protocol head's repeat_cost sets the lane (LAB-017 The number of audits follows the cost tier):
at "low" no freeze and no audit before the run, the one analysis audit after
it, decided before the number is adopted (`protocol-fill --from-run`, its
promotion) or steers a decision; at "high" `preflight`, the
preflight audit and the freeze before the run, which starts detached, and
the analysis audit after it. At both the run itself is the instrument check:
this skeleton has no --show and no --probe. The number is produced here, never
retyped (LAB-041 Generate numbers, don't retype them): the protocol's Result line cites it with the run_id, and
`scripts/02_analyze.py --check` (stamped beside this script) holds that line to the run.

Fill four constants — SOURCE, INPUTS, COUNT_FIELD, METRIC_KEY — and the
bodies of three functions — expected_ids(), rows(), evaluate_rows(); each
place carries a TODO, and none may be left. Everything else stays — `visible()` is the one reader of a directory, the
denominator is the source's id list, a missing item is a refusal. INPUTS names
what the rows read beyond SOURCE: a count of documents per case reads the case
directories, and only a frozen directory makes the number citable against
their content (three cold agents left them unfrozen, 2026-10-13); rows() reads
an item's directory through `input_dir()`, under INPUTS.

A task that names its output file (`pred_results/<name>.csv`) is answered
by that file: DELIVERABLES names it, deliverable_rows() gives its rows from
the kept rows and the metrics, and the run writes and registers it
(`write_deliverables`) — its sha256 lands in the run's outputs.json, and
`finalize` holds the file in the tree to it. Never write it by hand.

A task that states a value the number must match ("0.62 within 0.01", "at
least 0.20") is compared through the protocol head's `[reference]` table
(key, value, tolerance, relation, source — `labkit-init exp --reference`
stamps it; registered before the first measurement). `metrics_of()` reads
it and writes the verdict (`ref_state`, `ref_met`, `ref_distance`, …) into
metrics.json after evaluate_rows(); `02_analyze.py --check` recomputes it,
and the Recorded results line carries it. Without the table nothing is
compared and no `ref_*` key is written. A `not met` is a valid outcome —
never move the number or the value to meet it.
"""
from __future__ import annotations

import argparse
import json
from pathlib import Path

from labkit.formats import deliverable, protocol_block, reference
from labkit.formats.repo import next_after_run
from labkit.run import runlog

AREA = Path(__file__).resolve().parent.parent
REPO = AREA.parent.parent
PROTOCOL = AREA / "PROTOCOL-<name>.md"
SOURCE = REPO / "data" / "TODO"                 # what is counted — a file or a directory
INPUTS = None                                   # TODO: a directory the rows read beyond SOURCE (REPO / "data" / "raw" / "inputs"), frozen with it; None when SOURCE is all the number reads
OUT = AREA / "output" / "<name>.jsonl"          # one row per item, written by this script
COUNT_FIELD = "TODO_count"                      # the per-item number in each row
METRIC_KEY = "TODO_mean"                        # the kept number's key in metrics.json; the test reads both names from here
DELIVERABLES: tuple[str, ...] = ()              # files an external task names, relative to REPO ("pred_results/<name>.csv"); written by the run from the kept rows (`deliverable_rows`), registered as its outputs
DELIVERABLE_COLUMNS: tuple[str, ...] = ()       # the columns the task names for them, in its order; the write refuses other columns; () holds nothing


def visible(directory: Path) -> list[Path]:
    """The files that count: regular files, no hidden entries, no nested
    directories. `.DS_Store` once moved a mean by a whole document while
    test and --check stayed green (2026-10-05) — say in the protocol's
    `Unit:` field what one counted thing is, and keep this the only reader."""
    return sorted(p for p in directory.iterdir() if p.is_file() and not p.name.startswith("."))


def input_dir(record: dict, item_id: str) -> Path:
    """The directory of one item, under INPUTS — the frozen root decides what
    is read. A record that names its own `inputs` path must name INPUTS
    (relative to REPO); another path is a refusal: the run freezes INPUTS,
    and a number read from elsewhere could not be held to it."""
    if INPUTS is None:
        raise ValueError("input_dir(): INPUTS is None — set it to the directory the rows read")
    named = record.get("inputs")
    if named is not None and (REPO / named).resolve() != INPUTS.resolve():
        raise ValueError(
            f"input_dir(): {item_id} names inputs {named!r}, the run freezes "
            f"{INPUTS.relative_to(REPO)} — fix the record or INPUTS, never read past the frozen root"
        )
    return INPUTS / item_id


def expected_ids() -> list[str]:
    """TODO: the ids the number is over, read from SOURCE — the denominator
    comes from the source, never from the rows that happened to be produced."""
    raise NotImplementedError("expected_ids(): the ids SOURCE lists")


def rows(ids: list[str]) -> list[dict]:
    """TODO: one row per id — the raw material of the number. A missing or
    empty item is a refusal, not a skipped row. An item's directory comes
    from `input_dir(record, id)`, never from a path the record names alone."""
    raise NotImplementedError("rows(): one dict per id, fail loud on a missing one")


def evaluate_rows(items: list[dict], ids: list[str]) -> dict:
    """TODO: the number(s) from the rows, over the ids SOURCE lists — and,
    only if the protocol registers ids (a model in the loop), one key per id
    (`criterion_1_pass`); a plain count registers none. Every key lands in
    metrics.json, and `02_analyze.py --check` demands each verbatim in the protocol's
    "Recorded results" line — keep the dict to what that line carries.
    A number about the inputs the report states (records, a median, a derived
    threshold) belongs here, computed from the kept rows; one the rows cannot
    give owes rows that keep what it needs — never a count typed into the
    report. `--check` holds a key that vanished from the recomputation, not
    a number left out of this dict and written in prose."""
    if not ids:
        raise ValueError("evaluate_rows(): SOURCE lists no ids — refusing a number over nothing")
    if len(items) != len(ids):
        raise ValueError(f"evaluate_rows(): {len(items)} rows for {len(ids)} ids — a silent loss")
    raise NotImplementedError("evaluate_rows(): compute the number(s) from items")


def metrics_of(items: list[dict], ids: list[str]) -> dict:
    """The run's metrics: evaluate_rows() over ITEMS and IDS, and — when the
    protocol head registers a `[reference]` — the verdict of the kept number
    under its key against the stated value (`reference.with_verdict`: the one
    home of the comparison; `02_analyze.py --check` calls this too, so the
    verdict is held to the rows like every number). Reads PROTOCOL's head.
    Without a `[reference]` the metrics are evaluate_rows()'s alone."""
    ref = protocol_block.reference(PROTOCOL.read_text(encoding="utf-8"))
    return reference.with_verdict(evaluate_rows(items, ids), ref)


def deliverable_rows(path: str, items: list[dict], metrics: dict) -> list[dict]:
    """TODO (only with DELIVERABLES): the rows of the deliverable PATH, one
    dict per row with the task's columns as keys, in the task's order, from
    the kept ITEMS and the run's METRICS — never computed apart from them.
    A deliverable of one row (a summary) is a one-element list."""
    raise NotImplementedError(f"deliverable_rows(): the rows of {path} from items and metrics")


def write_deliverables(run: runlog.Run, items: list[dict], metrics: dict) -> None:
    """Write every DELIVERABLES file from the kept ITEMS and METRICS
    (`deliverable_rows`), held to DELIVERABLE_COLUMNS (a column missing,
    unnamed or out of order is refused, nothing written), and register it
    with RUN: the run records its sha256 at the end, and `finalize` holds
    the file to that record. Side effects: writes the files under REPO. No
    DELIVERABLES: nothing."""
    for path in DELIVERABLES:
        run.output(deliverable.write_csv(REPO / path, deliverable_rows(path, items, metrics),
                                         DELIVERABLE_COLUMNS))


def main() -> None:
    argparse.ArgumentParser(description=(__doc__ or "").splitlines()[0]).parse_args()
    ids = expected_ids()
    items = rows(ids)
    OUT.parent.mkdir(exist_ok=True)
    # data= freezes every input the number reads (sha and rows; a directory:
    # sha over each file) in the run; `finalize` refuses a run at low repeat cost
    # without it, and one whose source or OUT is not in git.
    frozen = {"source": SOURCE, **({"inputs": INPUTS} if INPUTS else {})}
    with runlog.run("<name>", config={k: str(p.relative_to(REPO)) for k, p in frozen.items()},
                    base_dir=AREA, data=frozen,
                    run_kind="measurement", protocol=PROTOCOL.name) as run:
        # every row names the run that wrote it (`_prov.run`): finalize holds
        # the file to it, and a row from another run is a file of two measurements
        OUT.write_text("".join(json.dumps({**r, "_prov": {"run": run.run_id}},
                                          ensure_ascii=False) + "\n" for r in items),
                       encoding="utf-8")
        run.output(OUT)
        metrics = metrics_of(items, ids)
        run.metrics(**metrics)
        write_deliverables(run, items, metrics)
        print(json.dumps(metrics, indent=1))
        print(f"run: {run.run_id}\n" + next_after_run(PROTOCOL, run.run_id))


if __name__ == "__main__":
    main()
