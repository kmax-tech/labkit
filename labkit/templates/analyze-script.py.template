#!/usr/bin/env python3
"""Hold the kept number to its own output — one formula, imported, never copied.

    ../../.venv/bin/python scripts/02_analyze.py            # the metrics, recomputed from OUT
    ../../.venv/bin/python scripts/02_analyze.py --check    # pin OUT to the run, recompute, hold the protocol (or NOTE) to it
    ../../.venv/bin/python scripts/02_analyze.py --draws    # the kept run and its repeats: the spread
    ../../.venv/bin/python scripts/02_analyze.py --check --protocol PROTOCOL-<name>.md   # as report-check runs it

Each for one protocol at a time: the one `--protocol` names, else the
area's only one — an area of several protocols owes the name. Every call,
the plain one and `--draws` too, first takes the protocol, the run that
answers it and that run's script, and ends with the reason where one of
them is missing.
`labkit.checks.recheck.holds` does the three things every area used to re-implement
(and twice got wrong, 2026-10-05): the output file pinned to the run's
recorded sha, metrics.json against `evaluate_rows()`, the protocol (or
`NOTE`, once the number is promoted) holding every reported number and the
run_id. The formula is the one of the script the
held run ran, imported (`recheck.script_module`: `01_measure.py`, or the
script of its own a second protocol of the area is measured by) — a second
copy here diverged from the measurement twice in one day (0.8333 against
0.9167), and another protocol's script is another number's formula. That
script defines `OUT`, `KEPT_KEY`, `evaluate_rows`, `read_jsonl` and
`answer_of` as `01_measure.py` does.
"""
from __future__ import annotations

import argparse
import json
from pathlib import Path
from types import ModuleType

from labkit.checks import recheck
from labkit.formats import answering_run, runs

AREA = Path(__file__).resolve().parent.parent
#: the note held to the numbers: None for the protocol itself, or
#: notes/results/<note>.md once the number is promoted
NOTE: Path | None = None


def draws(primary: Path, measure: ModuleType) -> list[str]:
    """The kept run PRIMARY and its repeats (`01_measure.py --repeat-of`),
    MEASURE the script PRIMARY ran: every draw
    held like the kept number (`recheck.verified`: its file pinned, scopes
    and block unchanged, its metrics recomputed from its rows), then the kept
    number per draw (`measure.KEPT_KEY`) with each registered criterion's
    verdict, its range, and the items whose parsed answer differs. The answer
    stays draw 1; this is the spread around it (LAB-036 Validate)."""
    seen: dict[str, dict[int, object]] = {}
    key = measure.KEPT_KEY
    lines, accs = [], []
    for n, d in answering_run.draws(AREA, primary.name):
        rows = [o.path for o in runs.read_outputs(d) or [] if o.path.suffix == ".jsonl"]
        if len(rows) != 1:
            raise SystemExit(f"draws: {d.name} registered {len(rows)} JSONL outputs, not one")
        m, _ = recheck.verified(d, AREA, rows[0], measure.evaluate_rows)
        accs.append(m[key])
        # a criterion's verdict by its key's shape: a key literal here would
        # read as reported where no criterion is registered
        verdicts = "".join(f"  {k} {v}" for k, v in m.items() if k.startswith("criterion_") and k.endswith("_pass"))
        lines.append(f"draw {n}  {d.name}  {key} {m[key]}{verdicts}")
        for r in measure.read_jsonl(rows[0]):
            seen.setdefault(r["id"], {})[n] = measure.answer_of(r)
    if len(accs) == 1:
        lines.append("one draw — no spread: `01_measure.py --repeat-of "
                     f"{primary.name}` draws it again")
        return lines
    known = [a for a in accs if isinstance(a, (int, float))]
    flipped = sorted(i for i, by_draw in seen.items() if len(set(by_draw.values())) > 1)
    lines.append(f"{key} over {len(accs)} draws: {min(known)} … {max(known)}")
    lines.append(f"items whose answer flipped: {len(flipped)} {flipped}")
    return lines


def main() -> None:
    ap = argparse.ArgumentParser(description=(__doc__ or "").splitlines()[0])
    ap.add_argument("--check", action="store_true",
                    help="pin OUT to the answering run, recompute, hold the protocol (or NOTE) to it")
    ap.add_argument("--draws", action="store_true",
                    help="the kept run and its repeats: the kept number per draw, range, flipped items")
    ap.add_argument("--protocol", metavar="FILE",
                    help="the protocol to hold, by file name — owed where the area has several")
    args = ap.parse_args()
    protocol = recheck.protocol_named(AREA, args.protocol)
    run = recheck.run_dir(AREA, protocol)        # the run that protocol answers with
    measure = recheck.script_module(AREA, run)   # the script that run ran: its formula, no other protocol's
    if args.draws:
        print("\n".join(draws(run, measure)))
        return
    if args.check:
        # the numbers as protocol-fill --from-run writes them (recheck.plain_numbers):
        # a format of its own here (`:.4f`) failed the check right after the
        # write-back (cold Sonnet, 2026-10-14)
        note = NOTE or protocol
        v = recheck.holds(area=AREA, out=measure.OUT, recompute=measure.evaluate_rows, note=note,
                          protocol=protocol)
        print(f"check: run {v.run_id} — {v.keys_compared} keys identical, {note.name} carries "
              f"the numbers and the run_id" + (f"; grown: {v.grown}" if v.grown else ""))
        return
    print(json.dumps(measure.evaluate_rows(measure.read_jsonl(measure.OUT)), indent=1))


if __name__ == "__main__":
    main()
