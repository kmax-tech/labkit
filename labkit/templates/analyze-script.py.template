#!/usr/bin/env python3
"""Hold the kept number to its own output — one formula, imported, never copied.

    ../../.venv/bin/python scripts/02_analyze.py            # the metrics, recomputed from OUT
    ../../.venv/bin/python scripts/02_analyze.py --check    # pin OUT to the run, recompute, hold NOTE to it
    ../../.venv/bin/python scripts/02_analyze.py --draws    # the kept run and its repeats: the spread

`labkit.checks.recheck.holds` does the three things every area used to re-implement
(and twice got wrong, 2026-10-05): the output file pinned to the run's
recorded sha, metrics.json against `evaluate_rows()`, the note holding every
reported number and the run_id. The formula is `01_measure.evaluate_rows`,
imported by path under a unique name — a second copy here diverged from the
measurement twice in one day (0.8333 against 0.9167).
"""
from __future__ import annotations

import argparse
import importlib.util
import json
import sys
from pathlib import Path

from labkit.checks import recheck
from labkit.formats import answering_run, runs

AREA = Path(__file__).resolve().parent.parent
NOTE = AREA / "PROTOCOL-<name>.md"     # or notes/results/<note>.md once the number is promoted
_spec = importlib.util.spec_from_file_location("measure_<name>", AREA / "scripts" / "01_measure.py")
assert _spec is not None and _spec.loader is not None
measure = importlib.util.module_from_spec(_spec)
sys.modules[_spec.name] = measure
_spec.loader.exec_module(measure)


def draws() -> list[str]:
    """The kept run and its repeats (`01_measure.py --repeat-of`): every draw
    held like the kept number (`recheck.verified`: its file pinned, scopes
    and block unchanged, its metrics recomputed from its rows), then criterion-1 per
    draw, its range, and the items whose parsed answer differs. The answer
    stays draw 1; this is the spread around it (LAB-036 Validate)."""
    primary = recheck.run_dir(AREA, NOTE)
    seen: dict[str, dict[int, object]] = {}
    key = measure.CRITERION_VALUE_KEY
    lines, accs = [], []
    for n, d in answering_run.draws(AREA, primary.name):
        rows = [o.path for o in runs.read_outputs(d) or [] if o.path.suffix == ".jsonl"]
        if len(rows) != 1:
            raise SystemExit(f"draws: {d.name} registered {len(rows)} JSONL outputs, not one")
        m, _ = recheck.verified(d, AREA, rows[0], measure.evaluate_rows)
        accs.append(m[key])
        lines.append(f"draw {n}  {d.name}  {key} {m[key]}  criterion_1_pass {m.get('criterion_1_pass')}")
        for r in measure.read_jsonl(rows[0]):
            seen.setdefault(r["id"], {})[n] = measure.answer_of(r)
    if len(accs) == 1:
        lines.append("one draw — no spread: `01_measure.py --repeat-of "
                     f"{primary.name}` draws it again")
        return lines
    known = [a for a in accs if isinstance(a, (int, float))]
    flipped = sorted(i for i, by_draw in seen.items() if len(set(by_draw.values())) > 1)
    lines.append(f"{key} over {len(accs)} draws: {min(known)} … {max(known)}")
    lines.append(f"items whose answer flipped: {len(flipped)} {flipped}")
    return lines


def main() -> None:
    ap = argparse.ArgumentParser(description=(__doc__ or "").splitlines()[0])
    ap.add_argument("--check", action="store_true",
                    help="pin OUT to the answering run, recompute, hold NOTE to it")
    ap.add_argument("--draws", action="store_true",
                    help="the kept run and its repeats: criterion-1 per draw, range, flipped items")
    args = ap.parse_args()
    if args.draws:
        print("\n".join(draws()))
        return
    if args.check:
        # the numbers as protocol-fill --from-run writes them (recheck.plain_numbers):
        # a format of its own here (`:.4f`) failed the check right after the
        # write-back (cold Sonnet, 2026-10-14)
        v = recheck.holds(area=AREA, out=measure.OUT, recompute=measure.evaluate_rows, note=NOTE)
        print(f"check: run {v.run_id} — {v.keys_compared} keys identical, {NOTE.name} carries "
              f"the numbers and the run_id" + (f"; grown: {v.grown}" if v.grown else ""))
        return
    print(json.dumps(measure.evaluate_rows(measure.read_jsonl(measure.OUT)), indent=1))


if __name__ == "__main__":
    main()
