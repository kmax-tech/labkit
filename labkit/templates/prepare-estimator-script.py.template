#!/usr/bin/env python3
"""raw -> prepared: materialise the data this experiment reads. ONE transformation.

    ../../.venv/bin/python scripts/00_prepare.py --show   # look at items, no write
    ../../.venv/bin/python scripts/00_prepare.py --audit  # the yield of every filter, no write
    ../../.venv/bin/python scripts/00_prepare.py          # write data/prepared/ (runlog)

Out: `data/prepared/<row-noun>_v1.jsonl` — read-only after writing. Naming
(LAB-020 Materialize transformations): the filename says what ONE row is, context-free
(`world_pairs`, `story_cells` — never just `pairs` or `items`); `_vN` counts
regenerations of the SAME meaning; a change in what a row MEANS (renamed or
re-coded fields included) is a NEW name, never a version bump. Rules with
evidence: LAB-020 Materialize transformations, LAB-021 No dataset without a producer.

Checks that belong HERE, not in the analysis: the yield of every filter,
per gold class — a one-sided filter puts itself inside the measured
quantity; apply it to the matched pair. `--audit` prints the yields. It
calls no data profile: `labkit.run.profile` counts words in a text field,
and an estimator's rows carry numeric features.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
AREA = HERE.parent
REPO = AREA.parent.parent
PROTOCOL = AREA / "PROTOCOL-<name>.md"
sys.path.insert(0, str(REPO / "lib"))   # repo-local helpers only
from labkit.run import batch, runlog
from labkit.formats import promises

SOURCE = REPO / "data" / "TODO"                 # raw input (record sha256 via runlog data=)
OUT = AREA / "data" / "prepared" / "TODO_v1.jsonl"   # <row-noun>_v1, see docstring

# The field legend — minted HERE, once (LAB-086 Values rule (codes are names too): values are names
# too). English only, no mixed-language names; every enum value is spelled
# out and self-explanatory. Written into the file as the `_meta` header and
# enforced per row by batch.write_dataset (field drift fails at write time).
ABOUT = "TODO: one sentence — what one row is and what this dataset is for."
FIELDS = {
    "id": "unique per row",
    "features": "TODO: the numeric features of one row, e.g. 2048 fingerprint bits, 0 or 1",
    "gold": "TODO: every gold value spelled out, e.g. causal | not_causal",
}

def build() -> tuple[list[dict], dict]:
    """Returns (items, yields) — one yield entry per filter, per gold class.

    The stamped default copies SOURCE (JSONL) row by row, keeping the FIELDS
    keys — all a clean raw file with id · features · gold needs (2026-10-07:
    three of three cold agents wrote exactly this by hand to copy twelve
    rows). Replace it when items are selected (fixed seed) or features
    computed from the raw rows (a fingerprint from a SMILES string, ...)."""
    items = []
    with SOURCE.open(encoding="utf-8") as fh:
        for n, line in enumerate(fh, 1):
            if not line.strip():
                continue
            row = json.loads(line)
            missing = [k for k in FIELDS if k not in row]
            if missing:
                raise SystemExit(f"{SOURCE.name}:{n}: row lacks {missing}")
            items.append({k: row[k] for k in FIELDS})
    return items, {"rows read": len(items)}


def audit(yields: dict) -> None:
    """The yield of every filter — no data profile (module docstring)."""
    print("== yield ==")
    for k in sorted(yields):
        print(f"  {k:28s} {yields[k]}")


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--show", action="store_true")
    ap.add_argument("--audit", action="store_true",
                    help="the yield of every filter, no write")
    args = ap.parse_args()

    items, yields = build()
    if args.show:
        for it in items[:10]:
            print(json.dumps(it, ensure_ascii=False))
        return
    if args.audit:
        audit(yields)
        return
    if OUT.exists():
        sys.exit(f"{OUT.name} exists — data/prepared/ is read-only, variant = new name")
    # TODO: every knob. The registered constants ride along: runlog refuses
    # any run under the promise block whose config lacks one, this step too
    # (cold Sonnet, judge at high, 2026-10-14: the first 00_prepare refused).
    config = {"source": str(SOURCE), "n_items": len(items),
              **promises.all_constants(promises.load(PROTOCOL))}
    # data= records SOURCE's path, sha256 and row count in the run — the raw
    # file this dataset came from stays answerable (the stamped run recorded
    # none, audit 2026-10-21). SOURCE is the file build() reads; a build()
    # reading several files lists each under its own key — a binary one
    # (.npz, .npy, model weights) declared as provenance.BinaryInput(path)
    # (`from labkit.run import provenance`): its sha256 is recorded, its
    # rows stay null; runlog reads any other path as text.
    with runlog.run("prepare", config=config, data={"source": SOURCE},
                    base_dir=AREA, run_kind="preparation") as run:
        # A producer REPLACES its file, never appends. write_dataset does;
        # if this producer must write row-by-row instead, use
        # batch.Store(OUT, mode="produce") — append-only Store turned a
        # second producer run into a 625+528-row hybrid (2026-09-09, area 71).
        batch.write_dataset(OUT, items, about=ABOUT, fields=FIELDS,
                            producer=Path(__file__).name)
        os.chmod(OUT, 0o444)
        print(f"{len(items)} items -> {OUT}")
        run.metrics(n_items=len(items))


if __name__ == "__main__":
    main()
