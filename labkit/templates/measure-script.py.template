#!/usr/bin/env python3
"""<the same measurement question as in PROTOCOL-<name>.md, one sentence>

Usage:
    ../../.venv/bin/python scripts/01_measure.py --show 3
        Render the prompts of three items for both lanes; no model call.
    ../../.venv/bin/python scripts/01_measure.py --probe
        Instrument check: twelve items through the real pipeline into a
        throwaway file; prints parser cases to paste into the test.
    ../../.venv/bin/python scripts/01_measure.py
        The full run, recorded by runlog (repeat_cost = "low": in the
        foreground; at high repeat cost: `runlog start <area> -- …`).
    ../../.venv/bin/python scripts/01_measure.py --eval-only
        Re-evaluate the kept rows; no model call.

Terms: a *lane* is one way of asking — the *registered lane* asks the
question under test, the *null lane* asks one the data cannot answer (the
noise floor of this run). *Quality checks* ([quality-check-…]) are what must hold before
any verdict; the *criterion* ([criterion-1]) is the verdict.

Measurement contract:
  - Every item runs once in each lane, in the same call.
  - Accuracy is correct answers over EVERY item of the lane: an empty or
    unreadable answer counts as not correct (else a model would gain
    accuracy by not answering) and is counted on its own as `*_empty`.
  - [criterion-1] passes when the registered lane's accuracy is at least the null
    lane's plus `margin`.
  - [quality-check-1] checks the registered lane's readable yield, [quality-check-2] that the null
    lane sits near chance. If either fails, [criterion-1] has no verdict (None).
  - Every registered id produces its metric key in every evaluation.
  - `evaluate_rows()` is the only implementation of these formulas;
    `02_analyze.py` and the test import it, never copy it.
  - The protocol owns the registered thresholds; `MeasureConfig` holds them
    for one execution; config.json records that object whole;
    `labkit-params <area>` shows every value with its home.
  - One answer vocabulary (`ANSWERS`), rendered into the prompt and read by
    the parser.

What to fill is the block below — the items, the text field, the answer
words, both prompts — and the null band in `evaluate_rows()`; every place
carries a TODO. Everything from `MeasureConfig` on is the experiment, and
stays. How the calls are made — one job per item and lane, the batches,
resume, the probe, the balance of the rows against the items, the command
line — is labkit's (`labkit.run.lanes`), the same in every area.

Why (house rules, one per line so a reference is never cut):
  LAB-034 Null condition in the same run
  LAB-035 Thresholds belong to the run
  LAB-041 Generate numbers, don't retype them
  LAB-004 Identifiers make the intent addressable
  LAB-052 Instance gate before registered use
  LAB-038 What the prompt demands
Stamped by `labkit-init exp <name>`.
"""
from __future__ import annotations

import hashlib
import sys
from dataclasses import dataclass
from fractions import Fraction
from pathlib import Path

HERE = Path(__file__).resolve().parent
AREA = HERE.parent
# Which protocol this script's runs belong to — named, not guessed: a series
# area holds many, and a run bound to the wrong one makes every later check
# green about the wrong promises.
PROTOCOL = AREA / "PROTOCOL-<name>.md"
REPO = AREA.parent.parent
sys.path.insert(0, str(REPO / "lib"))   # repo-local helpers only
from labkit.formats import promises
from labkit.run import lanes

# ===== What this measurement asks — fill every TODO of this block ==========

ITEMS = AREA / "data" / "prepared" / "TODO_v1.jsonl"   # written by 00_prepare.py: id · text · gold
TEXT_FIELD = "text"                                     # TODO: the item field the prompt shows
MODEL = "<model>"                                       # alias from models.toml, never an endpoint

# The answer vocabulary — one constant, two readers (prompt and parser).
# TODO: map each answer word to the gold label it means.
ANSWERS = {"Yes": "TODO-positive-gold", "No": "TODO-negative-gold"}
ANSWER_LINE = f"Answer with a single word, {' or '.join(ANSWERS)}."

# TODO: the registered question, verbatim — it goes into the PROTOCOL word
# for word (code-check holds the protocol's block to this constant).
PROMPT = ("TODO: the question about this text.\n\n"
          "Text: {text}\n\n" + ANSWER_LINE + "\n\nAnswer:")
# TODO: the null lane — same renderer, same parser, same label mapping, a
# question the data CANNOT answer. Its accuracy is the noise ceiling of THIS
# run; derive its expected value in the protocol's null-condition field
# (LAB-037 Every anchor carries its target and rationale). Safest placebo:
# one whose true answer is the SAME for every item ("Is this text written in
# English?") — its expected accuracy is the gold share of the class that
# answer maps to (0.5 on balanced gold). A placebo whose answer varies per
# item (numbers, length, negation) can track the gold label (usability
# probe 2026-10-07).
PROMPT_NULL = ("TODO: a question about this text that has nothing to do with the gold label.\n\n"
               "Text: {text}\n\n" + ANSWER_LINE + "\n\nAnswer:")

# Cases the criterion singles out, as DATA, when [criterion-…] names case classes:
# one [[case]] per such item in this file — `id` (the item's id in ITEMS),
# `cls` (a class [criterion-…] speaks of), `facts` (what the class follows from).
# The stamped test recomputes each class from its facts (CLASS_RULE there);
# the probe takes one case per class. No file: no classes.
CASE_CLASSES = AREA / "data" / "prepared" / "case_classes.toml"

# ===== The experiment — everything below stays ==============================

# One run, one output file. A second start of the same command RESUMES it
# (rows already answered are skipped); a new measurement — other prompt,
# model or items — gets a new file name, never two measurements in one file.
OUT = AREA / "output" / "<name>.jsonl"
LANES = {"registered": PROMPT, "null": PROMPT_NULL}


@dataclass(frozen=True)
class MeasureConfig:
    """Every value that shapes the number — one execution of this protocol.

    The PROTOCOL owns validity and meaning; this object materialises one
    execution; the run's config.json records it whole; `evaluate_rows()`
    reads its thresholds from here and nowhere else (the stamped test flips
    one and expects the verdict to move). The thresholds have NO default:
    they come from the protocol's [[promise]] tables under the SAME name
    (`constants = { margin = 0.25 }` ↔ `margin`) through
    `promises.all_constants()`; runlog refuses a run whose config lacks a
    registered constant or carries another value, and a constant this class
    does not know fails at import (TypeError: unexpected keyword).
    """

    margin: float               # [criterion-1]: registered accuracy ≥ null accuracy + margin
    max_empty: int              # [quality-check-1]: at most this many empty/unreadable answers on the registered lane;
                                # the stamped value is a placeholder: derive it for THIS item count, from how
                                # many empty answers still leave the number readable (LAB-028 An endpoint is a
                                # model slot) — and again when ITEMS changes
    null_band_items: int        # [quality-check-2]: the null lane sits at chance ± this many ITEMS (counted, not a share)
    model: str = MODEL          # alias from models.toml; runlog resolves it into models_resolved
    # the instrument's version: both prompts, so a reworded prompt is a
    # different config even when every threshold stays
    prompt_sha: str = hashlib.sha256((PROMPT + PROMPT_NULL).encode()).hexdigest()[:12]


# The registered execution: thresholds from the protocol, nothing copied;
# `--model` replaces one field.
CONFIG = MeasureConfig(**promises.all_constants(promises.load(PROTOCOL)))
#: the metrics key of the criterion's value — 02_analyze.py reads this name
C1_VALUE_KEY = "criterion_1_accuracy"


def parse_answer(text: str) -> str | None:
    """Model text -> gold label via ANSWERS, or None for empty/unreadable.
    Empty is its own state, never folded into a label (→ LAB-030 Reasoning models); the first
    token decides, a second line of explanation is ignored (→ LAB-023 No silent loss)."""
    text = text.strip()
    if not text:
        return None
    return ANSWERS.get(text.split()[0].rstrip(".,:;!"))


def answer_of(r: dict) -> str | None:
    """The parsed answer a row carries — what `02_analyze.py --draws` compares across draws."""
    return parse_answer(r["answer"])


def _counts(rows: list[dict]) -> tuple[int, int, int]:
    """(correct, items, empty) — integers, so a band is compared exactly. The
    denominator is every item of the lane: an empty or unreadable answer is
    not correct, and is counted on its own (LAB-030 Reasoning models)."""
    labels = [(parse_answer(r["answer"]), r["gold"]) for r in rows]
    empty = sum(1 for got, _ in labels if got is None)
    return sum(1 for got, gold in labels if got is not None and got == gold), len(rows), empty


def _accuracy(rows: list[dict]) -> tuple[float, int]:
    """(accuracy over every item of the lane, number of empty/unreadable)."""
    correct, items, empty = _counts(rows)
    return correct / items, empty


def _within_chance(rows: list[dict], items: int) -> bool:
    """Is the lane at chance ± `items` items? Compared in item counts:
    |correct - n/2| <= items, written as |2·correct - n| <= 2·items — in
    shares the band was asymmetric in floating point (7/12 out, 5/12 in)."""
    correct, n, _ = _counts(rows)
    return n > 0 and abs(2 * correct - n) <= 2 * items


def _at_least(reg: list[dict], null: list[dict], margin: float) -> bool:
    """[criterion-1] exactly: correct/items of the registered lane >= that of the null
    lane + margin, in fractions (margin as written, 0.25 = 1/4) — in floats
    a lane exactly at null + margin failed by one ulp."""
    rc, rn, _ = _counts(reg)
    nc, nn, _ = _counts(null)
    return Fraction(rc, rn) >= Fraction(nc, nn) + Fraction(str(margin))


def evaluate_rows(rows: list[dict], cfg: MeasureConfig = CONFIG) -> dict:
    """THE experiment, as a pure function of the stored rows and the config — gates first.

    Returns every registered id's keys on every lane:
      quality_check_1_empty · quality_check_1_pass           admissibility: yield of the registered lane
      quality_check_2_accuracy · quality_check_2_pass        admissibility: the null lane inside its band
      criterion_1_accuracy · criterion_1_threshold · criterion_1_pass   criterion: registered lane against null + cfg.margin
      n_items · n_rows             yield (→ LAB-023 No silent loss)
    A failed quality check reports its keys and no criterion verdict (`criterion_1_pass` None)."""
    if not rows:
        raise ValueError("evaluate_rows(): no rows — refusing a number over nothing")
    reg = [r for r in rows if r["lane"] == "registered"]
    null = [r for r in rows if r["lane"] == "null"]
    if not reg or not null:
        raise ValueError("evaluate_rows(): both lanes must be in the same run (LAB-034 Null condition in the same run)")
    reg_acc, reg_empty = _accuracy(reg)
    null_acc, null_empty = _accuracy(null)
    metrics: dict = {"n_items": len(reg), "n_rows": len(rows),
                     "quality_check_1_empty": reg_empty, "quality_check_1_pass": reg_empty <= cfg.max_empty,
                     "quality_check_2_accuracy": null_acc, "quality_check_2_empty": null_empty,
                     # TODO: the band the protocol derived for the null — cfg.null_band_items
                     # items around chance; a different expected rate needs its own count rule
                     "quality_check_2_pass": _within_chance(null, cfg.null_band_items)}
    admissible = metrics["quality_check_1_pass"] and metrics["quality_check_2_pass"]
    if not admissible:
        metrics.update({C1_VALUE_KEY: reg_acc, "criterion_1_threshold": None, "criterion_1_pass": None})
        return metrics
    metrics.update({C1_VALUE_KEY: reg_acc, "criterion_1_threshold": null_acc + cfg.margin,
                    "criterion_1_pass": _at_least(reg, null, cfg.margin)})
    return metrics


# ===== How it runs — labkit's, the same in every area =======================

RUN = lanes.Lanes(name="<name>", protocol=PROTOCOL, items=ITEMS, out=OUT, prompts=LANES,
                  text_field=TEXT_FIELD, parse_answer=parse_answer,
                  evaluate_rows=evaluate_rows, case_classes=CASE_CLASSES,
                  probe_cases_in="tests/test_<NN>_<name>.py")
# the names 02_analyze.py and the area test read
plan, measure, probe, evaluate, instrument = RUN.plan, RUN.measure, RUN.probe, RUN.evaluate, RUN.instrument
read_jsonl = lanes.read_jsonl


def read_case_classes() -> tuple[lanes.CaseClass, ...]:
    """The [[case]] rows of CASE_CLASSES (`lanes.read_case_classes`)."""
    return lanes.read_case_classes(CASE_CLASSES)


def one_per_class() -> tuple[str, ...]:
    """The probe's cases: the first id of every class."""
    return lanes.one_per_class(read_case_classes())


def main() -> None:
    """The command line (`--show`, `--probe`, `--eval-only`, `--repeat-of`, the run): `lanes.Lanes.main`."""
    RUN.main(CONFIG)


if __name__ == "__main__":
    main()
