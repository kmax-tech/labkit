{
  // Debug configurations: Run and Debug view (Cmd+Shift+D), pick one, F5.
  // Each names the repo's .venv itself: the interpreter VS Code remembers for
  // the folder may be another one (it ran ~/work/.venv, without pytest).
  // LABKIT_TEST_RAISE=1 makes a failing test stop the debugger at the failure
  // (tests/conftest.py) — tick "Uncaught Exceptions" in the Breakpoints panel.
  "version": "0.2.0",
  "configurations": [
    {
      // ONLY for the Testing view's "Debug Test" button, which supplies the
      // test to run; started with F5 it has nothing to run, so it is hidden
      // from the Run and Debug dropdown
      "name": "Test: debug (stop at failure)",
      "type": "debugpy",
      "python": "${workspaceFolder}/.venv/bin/python",
      "request": "launch",
      "purpose": ["debug-test"],
      "presentation": { "hidden": true },
      "console": "integratedTerminal",
      "env": { "LABKIT_TEST_RAISE": "1" },
      "justMyCode": true
    },
    {
      "name": "Test: the open test file (tests/test_*.py)",
      "type": "debugpy",
      "python": "${workspaceFolder}/.venv/bin/python",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "${file}"],
      "console": "integratedTerminal",
      "env": { "LABKIT_TEST_RAISE": "1" }
    },
    {
      "name": "Test: by name (-k)",
      "type": "debugpy",
      "python": "${workspaceFolder}/.venv/bin/python",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "tests", "-k", "${input:testName}"],
      "console": "integratedTerminal",
      "env": { "LABKIT_TEST_RAISE": "1" }
    },
    {
      // a console command from its entry point; arguments asked for at start
      "name": "Command: labkit module",
      "type": "debugpy",
      "python": "${workspaceFolder}/.venv/bin/python",
      "request": "launch",
      "module": "${input:command}",
      "args": "${command:pickArgs}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "testName",
      "type": "promptString",
      "description": "pytest -k expression (test or class name)"
    },
    {
      "id": "command",
      "type": "pickString",
      "description": "labkit command module (see [project.scripts] in pyproject.toml)",
      "options": [
        "labkit.gates.audit",
        "labkit.calltree",
        "labkit.checks.code_check",
        "labkit.gates.finalize",
        "labkit.checks.intent_check",
        "labkit.checks.notes_check",
        "labkit.params",
        "labkit.gates.preflight",
        "labkit.formats.protocol_check",
        "labkit.protocol_fill",
        "labkit.run.runlog",
        "labkit.formats.scope_sha"
      ]
    }
  ]
}
