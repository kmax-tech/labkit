+def _previous_call_name(call_id: str, prev_responses: list) -> str | None:
+    """The tool name of the earlier function or custom tool call CALL_ID,
+    whether that call is a parsed item or a plain dict; None when absent."""
+    for prev in reversed(prev_responses):
+        if isinstance(prev, dict):
+            if prev.get("type") in ("function_call", "custom_tool_call") and prev.get("call_id") == call_id:
+                return prev.get("name")
+        elif getattr(prev, "call_id", None) == call_id and getattr(prev, "type", None) in (
+            "function_call",
+            "custom_tool_call",
+        ):
+            return getattr(prev, "name", None)
+    return None
+
