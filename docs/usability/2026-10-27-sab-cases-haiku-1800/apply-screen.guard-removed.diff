+class PretrainedScreeningModel:
+    """A pre-trained logistic regression model that standardizes features,
+    computes weighted sum + intercept, applies logistic function, and thresholds."""
+
+    def __init__(self, model_path: Path):
+        with open(model_path) as f:
+            self.config = json.load(f)
+        self.features = self.config["features"]
+        self.means = self.config["mean"]
+        self.stds = self.config["std"]
+        self.weights = self.config["weights"]
+        self.intercept = self.config["intercept"]
+        self.threshold = self.config["threshold"]
+
+    def fit(self, X, y):
+        """No-op: the model is pre-trained and fixed."""
+        return self
+
+    def predict(self, X):
+        """Apply the pre-trained model and threshold: standardize, weighted sum,
+        logistic function, then flag >= threshold. Returns 0/1 class labels."""
+        import numpy as np
+        X_array = np.array(X) if not isinstance(X, list) else np.array(X)
+        # Standardize each feature
+        X_std = (X_array - self.means) / self.stds
+        # Weighted sum + intercept
+        logits = np.dot(X_std, self.weights) + self.intercept
+        # Logistic function: 1 / (1 + exp(-x))
+        probabilities = 1.0 / (1.0 + np.exp(-logits))
+        # Threshold to get class labels (0 or 1)
+        flags = (probabilities >= self.threshold).astype(int)
+        return flags
+
