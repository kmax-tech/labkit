---
title: "One labkit area at repeat cost low: commands, gates, last commit"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: Breaks CommittedNumberFromDataAsRun
    lg1: Path to the CommittedNumberFromDataAsRun bug
  }
  class lg0 breaks
  class lg1 bugPath
  state "At the same time" as all {
    state "Work" as r0 {
      s0: Registration open
      s1: Registered, nothing measured
      s2: Run in progress
      s3: Measured, not audited
      s4: Audit findings undecided
      s5: Ready to adopt
      s6: Adopted, report review owed
      s7: Adopted, report reviewed
      s8: Adopted, input changed since the run
      [*] --> s0
      s0 --> s1: protocol-fill writes the registration
      s1 --> s2: you start the run
      s2 --> s3: the run completes
      s3 --> s4: labkit-audit --mode analysis
      s4 --> s5: labkit-audit --decide
      s5 --> s6: labkit-adopt
      s6 --> s7: labkit-audit --report-review
      s7 --> s8: you change a data file outside the area [when Commit: adopted number, reviewed]
    }
    --
    state "Last commit" as r1 {
      s9: Commit: nothing measured
      s10: Commit: adopted number, reviewed
      s11: Commit: number on changed input
      [*] --> s9
      s9 --> s10: git commit (hook passes) [when Adopted, report reviewed]
      s10 --> s11: git commit (hook passes) [when Adopted, input changed since the run]
    }
  }
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s0 bugPath
  class s1 bugPath
  class s2 bugPath
  class s3 bugPath
  class s4 bugPath
  class s5 bugPath
  class s6 bugPath
  class s7 bugPath
  class s8 bugPath
  class s9 bugPath
  class s10 bugPath
  class s11 breaks
  class s11 bugPath
